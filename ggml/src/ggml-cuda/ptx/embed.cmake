# Writes the bytes of IN into OUT as a C++ array NAME (alignas 16) and NAME_size, for the hand-written PTX kernels'
# fatbins (C1138; ggml/src/ggml-cuda/CMakeLists.txt): cmake -DIN=<file> -DOUT=<file.cpp> -DNAME=<symbol> -P embed.cmake
file(READ "${IN}" hex HEX)
string(LENGTH "${hex}" n)
math(EXPR size "${n} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
string(REGEX REPLACE "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)" "\\1\n" bytes "${bytes}")
file(WRITE "${OUT}" "// generated by ptx/embed.cmake from ${IN}: do not edit\n#include <cstddef>\n"
    "alignas(16) extern const unsigned char ${NAME}[] = {\n${bytes}\n};\nextern const size_t ${NAME}_size = ${size};\n")
