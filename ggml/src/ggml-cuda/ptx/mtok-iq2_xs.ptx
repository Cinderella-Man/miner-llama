    fma.rn.ftz.f32 fr, fl0_1, fi, fp;         // (float) (ls0 * i0 + ls1 * i1), exactly
    fma.rn.ftz.f32 sf0_1, fa, fr, sf0_1;
    ld.shared.v4.u32 {ua0, ua1, ua2, ua3}, [au1+192];
    ld.shared.v4.u32 {ub0, ub1, ub2, ub3}, [au1+208];
    ld.shared.f32 fa, [ad1+24];
