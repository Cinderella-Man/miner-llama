    dp4a.s32.s32 ia, q0_1, ua1, ia;
    dp4a.s32.s32 ia, q0_2, ua2, ia;
    dp4a.s32.s32 ia, q0_3, ua3, ia;
    dp4a.s32.s32 ib1, q0_4, ub0, DBASE;
    dp4a.s32.s32 ib1, q0_5, ub1, ib1;
    dp4a.s32.s32 ib1, q0_6, ub2, ib1;
    dp4a.s32.s32 ib1, q0_7, ub3, ib1;
    mov.b32 fi, ib1;
    fma.rn.ftz.f32 fp, fl1_0, fi, nc1_0;     // ls1 * i1, exactly
    mov.b32 fi, ia;
    add.ftz.f32 fi, fi, 0fCB400000;              // i0, exactly
    fma.rn.ftz.f32 fr, fl0_0, fi, fp;         // (float) (ls0 * i0 + ls1 * i1), exactly
    fma.rn.ftz.f32 sf2_0, fa, fr, sf2_0;
    dp4a.s32.s32 ia, q1_0, ua0, DBASE;
    dp4a.s32.s32 ia, q1_1, ua1, ia;
    dp4a.s32.s32 ia, q1_2, ua2, ia;
    dp4a.s32.s32 ia, q1_3, ua3, ia;
    dp4a.s32.s32 ib1, q1_4, ub0, DBASE;
    dp4a.s32.s32 ib1, q1_5, ub1, ib1;
    dp4a.s32.s32 ib1, q1_6, ub2, ib1;
    dp4a.s32.s32 ib1, q1_7, ub3, ib1;
    mov.b32 fi, ib1;
    fma.rn.ftz.f32 fp, fl1_1, fi, nc1_1;     // ls1 * i1, exactly
    mov.b32 fi, ia;
    add.ftz.f32 fi, fi, 0fCB400000;              // i0, exactly
    fma.rn.ftz.f32 fr, fl0_1, fi, fp;         // (float) (ls0 * i0 + ls1 * i1), exactly
    fma.rn.ftz.f32 sf2_1, fa, fr, sf2_1;
    ld.shared.v4.u32 {ua0, ua1, ua2, ua3}, [au3+224];
    ld.shared.v4.u32 {ub0, ub1, ub2, ub3}, [au3+240];
    ld.shared.f32 fa, [ad3+28];
    dp4a.s32.s32 ia, q0_0, ua0, DBASE;
    dp4a.s32.s32 ia, q0_1, ua1, ia;
    dp4a.s32.s32 ia, q0_2, ua2, ia;
    dp4a.s32.s32 ia, q0_3, ua3, ia;
    dp4a.s32.s32 ib1, q0_4, ub0, DBASE;
    dp4a.s32.s32 ib1, q0_5, ub1, ib1;
    dp4a.s32.s32 ib1, q0_6, ub2, ib1;
    dp4a.s32.s32 ib1, q0_7, ub3, ib1;
    mov.b32 fi, ib1;
    fma.rn.ftz.f32 fp, fl1_0, fi, nc1_0;     // ls1 * i1, exactly
    mov.b32 fi, ia;
    add.ftz.f32 fi, fi, 0fCB400000;              // i0, exactly
    fma.rn.ftz.f32 fr, fl0_0, fi, fp;         // (float) (ls0 * i0 + ls1 * i1), exactly
    fma.rn.ftz.f32 sf3_0, fa, fr, sf3_0;
    dp4a.s32.s32 ia, q1_0, ua0, DBASE;
    dp4a.s32.s32 ia, q1_1, ua1, ia;
    dp4a.s32.s32 ia, q1_2, ua2, ia;
    dp4a.s32.s32 ia, q1_3, ua3, ia;
    dp4a.s32.s32 ib1, q1_4, ub0, DBASE;
    dp4a.s32.s32 ib1, q1_5, ub1, ib1;
    dp4a.s32.s32 ib1, q1_6, ub2, ib1;
    dp4a.s32.s32 ib1, q1_7, ub3, ib1;
    mov.b32 fi, ib1;
    fma.rn.ftz.f32 fp, fl1_1, fi, nc1_1;     // ls1 * i1, exactly
    mov.b32 fi, ia;
    add.ftz.f32 fi, fi, 0fCB400000;              // i0, exactly
    fma.rn.ftz.f32 fr, fl0_1, fi, fp;         // (float) (ls0 * i0 + ls1 * i1), exactly
    fma.rn.ftz.f32 sf3_1, fa, fr, sf3_1;
    // the super-block's d: lane 0's in the low half of dw, lane 1's in the high half
    shr.b32 t0, dw0, 16;
    selp.b32 dsh, t0, dw0, psl;
    mov.b32 {h0, h1}, dsh;
    cvt.f32.f16 fd, h0;
    mul.ftz.f32 fd, fd, 0f3E000000;
    fma.rn.ftz.f32 acc0_0, fd, sf0_0, acc0_0;
    fma.rn.ftz.f32 acc1_0, fd, sf1_0, acc1_0;
    fma.rn.ftz.f32 acc2_0, fd, sf2_0, acc2_0;
    fma.rn.ftz.f32 acc3_0, fd, sf3_0, acc3_0;
    shr.b32 t0, dw1, 16;
    selp.b32 dsh, t0, dw1, psl;
    mov.b32 {h0, h1}, dsh;
    cvt.f32.f16 fd, h0;
    mul.ftz.f32 fd, fd, 0f3E000000;
    fma.rn.ftz.f32 acc0_1, fd, sf0_1, acc0_1;
    fma.rn.ftz.f32 acc1_1, fd, sf1_1, acc1_1;
    fma.rn.ftz.f32 acc2_1, fd, sf2_1, acc2_1;
    fma.rn.ftz.f32 acc3_1, fd, sf3_1, acc3_1;
    add.u32 itr, itr, 1;
    setp.lt.u32 p0, itr, 5;
    @p0 bra.uni N4_ITER;
    // the row's two lanes summed, then up * SiLU(gate) (ggml_cuda_op_silu_single under -use_fast_math)
    mov.b32 rt0, acc0_0;
    shfl.sync.bfly.b32 rt1, rt0, 1, 31, -1;
    mov.b32 fs, rt1;
    add.ftz.f32 acc0_0, acc0_0, fs;
    mov.b32 rt0, acc0_1;
    shfl.sync.bfly.b32 rt1, rt0, 1, 31, -1;
    mov.b32 fs, rt1;
    add.ftz.f32 acc0_1, acc0_1, fs;
    mov.b32 rt0, acc1_0;
    shfl.sync.bfly.b32 rt1, rt0, 1, 31, -1;
    mov.b32 fs, rt1;
    add.ftz.f32 acc1_0, acc1_0, fs;
    mov.b32 rt0, acc1_1;
    shfl.sync.bfly.b32 rt1, rt0, 1, 31, -1;
    mov.b32 fs, rt1;
    add.ftz.f32 acc1_1, acc1_1, fs;
    mov.b32 rt0, acc2_0;
    shfl.sync.bfly.b32 rt1, rt0, 1, 31, -1;
    mov.b32 fs, rt1;
    add.ftz.f32 acc2_0, acc2_0, fs;
    mov.b32 rt0, acc2_1;
    shfl.sync.bfly.b32 rt1, rt0, 1, 31, -1;
    mov.b32 fs, rt1;
    add.ftz.f32 acc2_1, acc2_1, fs;
    mov.b32 rt0, acc3_0;
    shfl.sync.bfly.b32 rt1, rt0, 1, 31, -1;
    mov.b32 fs, rt1;
    add.ftz.f32 acc3_0, acc3_0, fs;
    mov.b32 rt0, acc3_1;
    shfl.sync.bfly.b32 rt1, rt0, 1, 31, -1;
    mov.b32 fs, rt1;
    add.ftz.f32 acc3_1, acc3_1, fs;
    setp.eq.u32 p0, sl, 0;
    setp.lt.u32 pst, row0, nrows;
    and.pred pst, pst, p0;
    mul.ftz.f32 fe, acc0_1, 0fBFB8AA3B;
    ex2.approx.ftz.f32 fe, fe;
    add.ftz.f32 fe, fe, 0f3F800000;
    div.approx.ftz.f32 fg, acc0_1, fe;
    mul.ftz.f32 fu, acc0_0, fg;
    add.u32 t0, dc0, row0;
    mul.wide.u32 o64, t0, 4;
    add.u64 a64, dstp, o64;
    @pst st.global.f32 [a64], fu;
    mul.ftz.f32 fe, acc1_1, 0fBFB8AA3B;
    ex2.approx.ftz.f32 fe, fe;
    add.ftz.f32 fe, fe, 0f3F800000;
    div.approx.ftz.f32 fg, acc1_1, fe;
    mul.ftz.f32 fu, acc1_0, fg;
    add.u32 t0, dc1, row0;
    mul.wide.u32 o64, t0, 4;
    add.u64 a64, dstp, o64;
    @pst st.global.f32 [a64], fu;
    mul.ftz.f32 fe, acc2_1, 0fBFB8AA3B;
    ex2.approx.ftz.f32 fe, fe;
    add.ftz.f32 fe, fe, 0f3F800000;
    div.approx.ftz.f32 fg, acc2_1, fe;
    mul.ftz.f32 fu, acc2_0, fg;
    add.u32 t0, dc2, row0;
    mul.wide.u32 o64, t0, 4;
    add.u64 a64, dstp, o64;
    @pst st.global.f32 [a64], fu;
    mul.ftz.f32 fe, acc3_1, 0fBFB8AA3B;
    ex2.approx.ftz.f32 fe, fe;
    add.ftz.f32 fe, fe, 0f3F800000;
    div.approx.ftz.f32 fg, acc3_1, fe;
    mul.ftz.f32 fu, acc3_0, fg;
    add.u32 t0, dc3, row0;
    mul.wide.u32 o64, t0, 4;
    add.u64 a64, dstp, o64;
    @pst st.global.f32 [a64], fu;
    add.u32 rbi, rbi, 1;
    bra.uni N4_ROWBLOCK;

SKIPPED:
    // a skipped slot (id -1): zeros in its rows of the output
    cvt.u64.u32 w64, bz;
    mul.lo.u64 x64, w64, ssd;
    cvt.u64.u32 w64, ky;
    mad.lo.u64 x64, w64, scd, x64;
    cvt.u64.u32 w64, ty;
    mad.lo.u64 x64, w64, scold, x64;
    shl.b64 x64, x64, 2;
    add.u64 dsk, dstp, x64;
    and.b32 sl, lane, 1;
    shr.b32 grp, lane, 1;
    mov.u32 rbi, 0;
SKIP_ROWS:
    setp.ge.u32 p0, rbi, rb;
    @p0 bra.uni DONE;
    mad.lo.u32 rblk, bx, rb, rbi;
    setp.ge.u32 p0, rblk, nrowblocks;
    @p0 bra.uni DONE;
    shl.b32 row0, rblk, 6;
    add.u32 row0, row0, warp;
    shl.b32 t0, grp, 2;
    add.u32 row0, row0, t0;
    setp.eq.u32 p1, sl, 0;
    setp.lt.u32 p2, row0, nrows;
    and.pred p1, p1, p2;
    mul.wide.u32 o64, row0, 4;
    add.u64 a64, dsk, o64;
    @p1 st.global.f32 [a64], 0f00000000;
    add.u32 rbi, rbi, 1;
    bra.uni SKIP_ROWS;
DONE:
    ret;
}

.visible .entry mtok_iq2xs_fast_ptx_ntm8(
    .param .align 8 .b8 P[168],
    .param .align 8 .b8 F[80]
)
.maxntid 128, 1, 1
.minnctapersm 2
{
    .reg .pred p0, p1, p2, p3, p4, pq, psl, pst;
    .reg .b16 h0, h1;
    .reg .b32 lane, warp, bx, by, bz, tid, nrows, row_bytes, nrowblocks, rb, gcap, ncols;
    .reg .b32 nslots, ids_stride, act_tok, ncy_x, ncy_y, ncy_z, sr_x, sr_y, t0, t1, t2, t3;
    .reg .b32 sx, ne, ty, ky, ey, idx, rank, i, v, bal, cnt, mk0;
    .reg .b32 mk1, mk2, mk3, total, hsel, rr, msk, nt, yoff, doff, bit, kk;
    .reg .b32 chy, tabb, e, sa, cw0, cw1, cw2, cw3, act, jm, yj, aj;
    .reg .b32 drel, srel, pa0, pa1, pa2, pa3, y0, y1, y2, y3, y4, y5;
    .reg .b32 y6, y7, y8, sl, grp, sel, tabl, ad0, rbx, LP, LN, LS;
    .reg .b32 K3333, ZERO, DBASE, K1E, K01, KEXP, coff, dc0, rbi, rblk, row0, rowc;
    .reg .b32 kap0, kap, itr, cs, au, ad, sego, u0_0, u0_1, u0_2, u0_3, u0_4;
    .reg .b32 u0_5, u0_6, u0_7, u0_8, u0_9, u0_10, u0_11, u0_12, u0_13, u0_14, u0_15, u0_16;
    .reg .b32 u0_17, u0_18, u0_19, u1_0, u1_1, u1_2, u1_3, u1_4, u1_5, u1_6, u1_7, u1_8;
    .reg .b32 u1_9, u1_10, u1_11, u1_12, u1_13, u1_14, u1_15, u1_16, u1_17, u1_18, u1_19, w0_0;
    .reg .b32 w0_1, w0_2, w0_3, w0_4, w0_5, w0_6, w0_7, w0_8, w0_9, w0_10, w0_11, w0_12;
    .reg .b32 w0_13, w0_14, w0_15, w0_16, w0_17, dw0, w1_0, w1_1, w1_2, w1_3, w1_4, w1_5;
    .reg .b32 w1_6, w1_7, w1_8, w1_9, w1_10, w1_11, w1_12, w1_13, w1_14, w1_15, w1_16, w1_17;
    .reg .b32 dw1, s7, t6, x, pc, sn, hi, ea, cw, sv, sh, ia;
    .reg .b32 ib1, ts, q0_0, q0_1, q0_2, q0_3, q0_4, q0_5, q0_6, q0_7, q1_0, q1_1;
    .reg .b32 q1_2, q1_3, q1_4, q1_5, q1_6, q1_7, ua0, ua1, ua2, ua3, ub0, ub1;
    .reg .b32 ub2, ub3, e0_0, e0_1, e1_0, e1_1, dsh, rt0, rt1, dc1, au1, ad1;
    .reg .b32 dc2, au2, ad2, dc3, au3, ad3, dc4, au4, ad4, dc5, au5, ad5;
    .reg .b32 dc6, au6, ad6, dc7, au7, ad7;
    .reg .b64 vx, vy, ids, dstp, gatep, chbx, smbx, chby, smby, colby, scd, ssd;
    .reg .b64 scold, a64, o64, w64, x64, cods, xo, xu, xg, sl64, rw0, rw1;
    .reg .b64 ro64, seg, dsk;
    .reg .f32 fsc, acc0_0, acc0_1, sf0_0, sf0_1, fl0_0, fl0_1, fl1_0, fl1_1, nc1_0, nc1_1, fa;
    .reg .f32 fi, fp, fr, fd, fs, fu, fg, fe, acc1_0, acc1_1, sf1_0, sf1_1;
    .reg .f32 acc2_0, acc2_1, sf2_0, sf2_1, acc3_0, acc3_1, sf3_0, sf3_1, acc4_0, acc4_1, sf4_0, sf4_1;
    .reg .f32 acc5_0, acc5_1, sf5_0, sf5_1, acc6_0, acc6_1, sf6_0, sf6_1, acc7_0, acc7_1, sf7_0, sf7_1;
    .shared .align 16 .b32 tab[4096];

    // thread, block and parameters
    mov.u32 lane, %tid.x;
    mov.u32 warp, %tid.y;
    mov.u32 bx, %ctaid.x;
    mov.u32 by, %ctaid.y;
    mov.u32 bz, %ctaid.z;
    mad.lo.u32 tid, warp, 32, lane;
    ld.param.u64 vx, [P+0];
    cvta.to.global.u64 vx, vx;
    ld.param.u64 vy, [P+8];
    cvta.to.global.u64 vy, vy;
    ld.param.u64 ids, [P+16];
    cvta.to.global.u64 ids, ids;
    ld.param.u64 dstp, [P+24];
    cvta.to.global.u64 dstp, dstp;
    ld.param.u64 gatep, [F+8];
    cvta.to.global.u64 gatep, gatep;
    ld.param.u32 nrows, [P+32];
    ld.param.u32 row_bytes, [P+36];
    ld.param.u32 nrowblocks, [P+48];
    ld.param.u32 rb, [P+52];
    ld.param.u32 gcap, [P+56];
    ld.param.u32 ncols, [P+60];
    ld.param.u32 nslots, [P+64];
    ld.param.u32 ids_stride, [P+68];
    ld.param.u32 act_tok, [P+76];
    ld.param.u32 ncy_x, [P+80];
    ld.param.u32 ncy_y, [P+84];
    ld.param.u32 ncy_z, [P+88];
    ld.param.u32 sr_x, [P+92];
    ld.param.u32 sr_y, [P+96];
    ld.param.u64 chbx, [P+104];
    ld.param.u64 smbx, [P+112];
    ld.param.u64 chby, [P+120];
    ld.param.u64 smby, [P+128];
    ld.param.u64 colby, [P+136];
    ld.param.u64 scd, [P+144];
    ld.param.u64 ssd, [P+152];
    ld.param.u64 scold, [P+160];
    // sample_x = fastdiv(blockIdx.z, sample_ratio)
    mul.hi.u32 t0, bz, sr_x;
    add.u32 t0, t0, bz;
    shr.b32 sx, t0, sr_y;

    // the block's group (mtok_iq::group): entry blockIdx.y = token ty, slot ky; its expert ey
    mul.lo.u32 ne, ncols, nslots;
    div.u32 ty, by, nslots;
    mul.lo.u32 t0, ty, nslots;
    sub.u32 ky, by, t0;
    mad.lo.u32 idx, ty, ids_stride, ky;
    mul.wide.u32 o64, idx, 4;
    add.u64 a64, ids, o64;
    ld.global.s32 ey, [a64];
    setp.lt.s32 p0, ey, 0;
    @p0 bra.uni SKIPPED;
    // rank: the entries before this one with the same expert; mk<h>: those from it on, 32 entries a word
    mov.u32 rank, 0;
    add.u32 i, lane, 0;
    div.u32 t0, i, nslots;
    mul.lo.u32 t1, t0, nslots;
    sub.u32 t1, i, t1;
    mad.lo.u32 idx, t0, ids_stride, t1;
    mul.wide.u32 o64, idx, 4;
    add.u64 a64, ids, o64;
    setp.lt.u32 p1, i, ne;
    mov.u32 v, -1;
    @p1 ld.global.s32 v, [a64];
    setp.eq.s32 p2, v, ey;
    setp.lt.u32 p3, i, by;
    and.pred p4, p2, p3;
    vote.sync.ballot.b32 bal, p4, -1;
    popc.b32 cnt, bal;
    add.u32 rank, rank, cnt;
    setp.ge.u32 p3, i, by;
    and.pred p4, p2, p3;
    vote.sync.ballot.b32 mk0, p4, -1;
    add.u32 i, lane, 32;
    div.u32 t0, i, nslots;
    mul.lo.u32 t1, t0, nslots;
    sub.u32 t1, i, t1;
    mad.lo.u32 idx, t0, ids_stride, t1;
    mul.wide.u32 o64, idx, 4;
    add.u64 a64, ids, o64;
    setp.lt.u32 p1, i, ne;
    mov.u32 v, -1;
    @p1 ld.global.s32 v, [a64];
    setp.eq.s32 p2, v, ey;
    setp.lt.u32 p3, i, by;
    and.pred p4, p2, p3;
    vote.sync.ballot.b32 bal, p4, -1;
    popc.b32 cnt, bal;
    add.u32 rank, rank, cnt;
    setp.ge.u32 p3, i, by;
    and.pred p4, p2, p3;
    vote.sync.ballot.b32 mk1, p4, -1;
    add.u32 i, lane, 64;
    div.u32 t0, i, nslots;
    mul.lo.u32 t1, t0, nslots;
    sub.u32 t1, i, t1;
    mad.lo.u32 idx, t0, ids_stride, t1;
    mul.wide.u32 o64, idx, 4;
    add.u64 a64, ids, o64;
    setp.lt.u32 p1, i, ne;
    mov.u32 v, -1;
    @p1 ld.global.s32 v, [a64];
    setp.eq.s32 p2, v, ey;
    setp.lt.u32 p3, i, by;
    and.pred p4, p2, p3;
    vote.sync.ballot.b32 bal, p4, -1;
    popc.b32 cnt, bal;
    add.u32 rank, rank, cnt;
    setp.ge.u32 p3, i, by;
    and.pred p4, p2, p3;
    vote.sync.ballot.b32 mk2, p4, -1;
    add.u32 i, lane, 96;
    div.u32 t0, i, nslots;
    mul.lo.u32 t1, t0, nslots;
    sub.u32 t1, i, t1;
    mad.lo.u32 idx, t0, ids_stride, t1;
    mul.wide.u32 o64, idx, 4;
    add.u64 a64, ids, o64;
    setp.lt.u32 p1, i, ne;
    mov.u32 v, -1;
    @p1 ld.global.s32 v, [a64];
    setp.eq.s32 p2, v, ey;
    setp.lt.u32 p3, i, by;
    and.pred p4, p2, p3;
    vote.sync.ballot.b32 bal, p4, -1;
    popc.b32 cnt, bal;
    add.u32 rank, rank, cnt;
    setp.ge.u32 p3, i, by;
    and.pred p4, p2, p3;
    vote.sync.ballot.b32 mk3, p4, -1;
    rem.u32 t0, rank, gcap;
    setp.ne.u32 p0, t0, 0;
    @p0 bra.uni DONE;
    // lane j < nt finds the group's member j: the j-th set bit of mk0..mk3
    mov.u32 total, 0;
    mov.u32 hsel, 4;
    mov.u32 rr, 0;
    mov.u32 msk, 0;
    popc.b32 cnt, mk0;
    add.u32 t0, total, cnt;
    setp.eq.u32 p1, hsel, 4;
    setp.lt.u32 p2, lane, t0;
    and.pred p3, p1, p2;
    @p3 mov.u32 hsel, 0;
    @p3 sub.u32 rr, lane, total;
    @p3 mov.u32 msk, mk0;
    mov.u32 total, t0;
    popc.b32 cnt, mk1;
    add.u32 t0, total, cnt;
    setp.eq.u32 p1, hsel, 4;
    setp.lt.u32 p2, lane, t0;
    and.pred p3, p1, p2;
    @p3 mov.u32 hsel, 1;
    @p3 sub.u32 rr, lane, total;
    @p3 mov.u32 msk, mk1;
    mov.u32 total, t0;
    popc.b32 cnt, mk2;
    add.u32 t0, total, cnt;
    setp.eq.u32 p1, hsel, 4;
    setp.lt.u32 p2, lane, t0;
    and.pred p3, p1, p2;
    @p3 mov.u32 hsel, 2;
    @p3 sub.u32 rr, lane, total;
    @p3 mov.u32 msk, mk2;
    mov.u32 total, t0;
    popc.b32 cnt, mk3;
    add.u32 t0, total, cnt;
    setp.eq.u32 p1, hsel, 4;
    setp.lt.u32 p2, lane, t0;
    and.pred p3, p1, p2;
    @p3 mov.u32 hsel, 3;
    @p3 sub.u32 rr, lane, total;
    @p3 mov.u32 msk, mk3;
    mov.u32 total, t0;
    min.u32 nt, gcap, total;
    mov.u32 yoff, 0;
    mov.u32 doff, 0;
    setp.ge.u32 p1, lane, nt;
    @p1 bra MEMBER_DONE;
DROP_BITS:
    setp.eq.u32 p2, rr, 0;
    @p2 bra DROPPED;
    add.u32 t0, msk, -1;
    and.b32 msk, msk, t0;
    sub.u32 rr, rr, 1;
    bra DROP_BITS;
DROPPED:
    neg.s32 t0, msk;
    and.b32 t0, msk, t0;
    bfind.u32 bit, t0;
    shl.b32 i, hsel, 5;
    add.u32 i, i, bit;
    div.u32 t0, i, nslots;
    mul.lo.u32 t1, t0, nslots;
    sub.u32 kk, i, t1;
    // channel_y = fastmodulo(k, nchannels_y)
    mul.hi.u32 t2, kk, ncy_x;
    add.u32 t2, t2, kk;
    shr.b32 t2, t2, ncy_y;
    mul.lo.u32 t2, t2, ncy_z;
    sub.u32 chy, kk, t2;
    // yoff = sample * sample_bytes_y + channel_y * channel_bytes_y + token * col_bytes_y (fits an int)
    cvt.u64.u32 w64, bz;
    mul.lo.u64 x64, w64, smby;
    cvt.u64.u32 w64, chy;
    mad.lo.u64 x64, w64, chby, x64;
    cvt.u64.u32 w64, t0;
    mad.lo.u64 x64, w64, colby, x64;
    cvt.u32.u64 yoff, x64;
    // doff = sample * stride_sample_dst + slot * stride_channel_dst + token * stride_col_dst
    cvt.u64.u32 w64, bz;
    mul.lo.u64 x64, w64, ssd;
    cvt.u64.u32 w64, kk;
    mad.lo.u64 x64, w64, scd, x64;
    cvt.u64.u32 w64, t0;
    mad.lo.u64 x64, w64, scold, x64;
    cvt.u32.u64 doff, x64;
MEMBER_DONE:

    // the code table: entry e's eight codes (0, 1, 2 for 8, 25, 43) as nibbles, 8 copies interleaved by word
    mov.u32 tabb, tab;
    mov.u64 cods, mtok_iq2xs_codes;
    mul.wide.u32 o64, tid, 4;
    add.u64 a64, cods, o64;
    ld.global.nc.u32 cw0, [a64+0];
    ld.global.nc.u32 cw1, [a64+512];
    ld.global.nc.u32 cw2, [a64+1024];
    ld.global.nc.u32 cw3, [a64+1536];
    shl.b32 sa, tid, 5;
    add.u32 sa, sa, tabb;
    st.shared.v4.u32 [sa+0], {cw0, cw0, cw0, cw0};
    st.shared.v4.u32 [sa+16], {cw0, cw0, cw0, cw0};
    st.shared.v4.u32 [sa+4096], {cw1, cw1, cw1, cw1};
    st.shared.v4.u32 [sa+4112], {cw1, cw1, cw1, cw1};
    st.shared.v4.u32 [sa+8192], {cw2, cw2, cw2, cw2};
    st.shared.v4.u32 [sa+8208], {cw2, cw2, cw2, cw2};
    st.shared.v4.u32 [sa+12288], {cw3, cw3, cw3, cw3};
    st.shared.v4.u32 [sa+12304], {cw3, cw3, cw3, cw3};
    // the members' activations: each group of 8 int8 values as (0, 1, 4, 5), (2, 3, 6, 7); thread q < 80 stages
    // Q8_1 block q of each member: 256 values and 16 bytes of padding per super-block, the FP32 scales after them
    mov.u32 act, mtok_iq2xs_dyn;
    setp.lt.u32 pq, tid, 80;
    shr.b32 t0, tid, 3;
    and.b32 t1, tid, 7;
    shl.b32 t1, t1, 5;
    mad.lo.u32 drel, t0, 272, t1;
    shl.b32 srel, tid, 2;
    add.u32 srel, srel, 2720;
    mul.wide.u32 w64, tid, 36;
    mov.u32 jm, 0;
STAGE_MEMBER:
    setp.ge.u32 p0, jm, nt;
    @p0 bra.uni STAGED;
    shfl.sync.idx.b32 yj, yoff, jm, 31, -1;
    mad.lo.u32 aj, jm, act_tok, act;
    cvt.s64.s32 x64, yj;
    add.u64 a64, vy, x64;
    add.u64 a64, a64, w64;
    @pq ld.global.nc.u32 y0, [a64+0];
    @pq ld.global.nc.u32 y1, [a64+4];
    @pq ld.global.nc.u32 y2, [a64+8];
    @pq ld.global.nc.u32 y3, [a64+12];
    @pq ld.global.nc.u32 y4, [a64+16];
    @pq ld.global.nc.u32 y5, [a64+20];
    @pq ld.global.nc.u32 y6, [a64+24];
    @pq ld.global.nc.u32 y7, [a64+28];
    @pq ld.global.nc.u32 y8, [a64+32];
    add.u32 sa, aj, drel;
    prmt.b32 pa0, y1, y2, 0x5410;
    prmt.b32 pa1, y1, y2, 0x7632;
    prmt.b32 pa2, y3, y4, 0x5410;
    prmt.b32 pa3, y3, y4, 0x7632;
    @pq st.shared.v4.u32 [sa], {pa0, pa1, pa2, pa3};
    prmt.b32 pa0, y5, y6, 0x5410;
    prmt.b32 pa1, y5, y6, 0x7632;
    prmt.b32 pa2, y7, y8, 0x5410;
    prmt.b32 pa3, y7, y8, 0x7632;
    @pq st.shared.v4.u32 [sa+16], {pa0, pa1, pa2, pa3};
    mov.b32 {h0, h1}, y0;
    cvt.f32.f16 fsc, h0;
    add.u32 sa, aj, srel;
    @pq st.shared.f32 [sa], fsc;
    add.u32 jm, jm, 1;
    bra.uni STAGE_MEMBER;
STAGED:
    bar.sync 0;

    // the expert's up and gate matrices; constants
    cvt.u64.u32 w64, sx;
    mul.lo.u64 xo, w64, smbx;
    cvt.u64.u32 w64, ey;
    mad.lo.u64 xo, w64, chbx, xo;
    add.u64 xu, vx, xo;
    add.u64 xg, gatep, xo;
    and.b32 sl, lane, 1;
    shr.b32 grp, lane, 1;
    setp.ne.u32 psl, sl, 0;
    selp.b32 sel, 0x7654, 0x5432, psl;
    and.b32 t0, lane, 7;
    shl.b32 t0, t0, 2;
    add.u32 tabl, tabb, t0;
    add.u32 ad0, act, 2720;
    mul.lo.u32 rbx, bx, rb;
    mul.wide.u32 sl64, sl, 72;
    mov.b32 LP, 0x002b1908;    // bytes 8, 25, 43, 0: the grid values by code
    mov.b32 LN, 0x00d5e7f8;    // -8, -25, -43, 0
    mov.b32 LS, 0x44400400;    // two sign bits (index b0 + 2 b1) -> bit 2 of two nibbles
    mov.b32 K3333, 0x3333;
    mov.b32 ZERO, 0;
    mov.b32 DBASE, 0x4B400000; // the float 1.5 * 2^23: a DP4A chain started there is that float + its sum
    and.b32 coff, lane, 7;
    shl.b32 coff, coff, 2;      // the lane's copy of the code table: bits 2-4 of its word address
    mov.b32 K1E, 0x1E1E1E1E;   // 2 s in every byte
    mov.b32 K01, 0x01010101;
    mov.b32 KEXP, 0x4B000000;  // the exponent of 2^23: a byte b under it is the float 2^23 + b

    setp.eq.u32 p0, nt, 1;
    @p0 bra.uni BODY1;
    setp.eq.u32 p0, nt, 2;
    @p0 bra.uni BODY2;
    setp.eq.u32 p0, nt, 3;
    @p0 bra.uni BODY3;
    setp.eq.u32 p0, nt, 4;
    @p0 bra.uni BODY4;
    setp.eq.u32 p0, nt, 5;
    @p0 bra.uni BODY5;
    setp.eq.u32 p0, nt, 6;
    @p0 bra.uni BODY6;
    setp.eq.u32 p0, nt, 7;
    @p0 bra.uni BODY7;
    bra.uni BODY8;

BODY1:
    // groups of 1 member(s): member j's output offset dc<j>
    shfl.sync.idx.b32 dc0, doff, 0, 31, -1;
    mov.u32 rbi, 0;
N1_ROWBLOCK:
    setp.ge.u32 p0, rbi, rb;
    @p0 bra.uni DONE;
    add.u32 rblk, rbx, rbi;
    setp.ge.u32 p0, rblk, nrowblocks;
    @p0 bra.uni DONE;
    // rows 4 apart: warp w takes rows w, w + 4, ..., w + 60 of the row block; lane pair grp row w + 4 grp
    shl.b32 row0, rblk, 6;
    add.u32 row0, row0, warp;
    shl.b32 t0, grp, 2;
    add.u32 row0, row0, t0;
    add.u32 t0, nrows, -1;
    min.u32 rowc, row0, t0;
    mul.wide.u32 ro64, rowc, row_bytes;
    add.u64 rw0, xu, ro64;
    add.u64 rw1, xg, ro64;
    // kappa: the word of its first 8-byte unit at which the warp's segments start (lane 0's row)
    cvt.u32.u64 t0, rw0;
    bfe.u32 t0, t0, 2, 1;
    shfl.sync.idx.b32 kap0, t0, 0, 31, -1;
    mov.f32 acc0_0, 0f00000000;
    mov.f32 acc0_1, 0f00000000;
    mov.u32 itr, 0;
N1_ITER:
    // the lane's super-block c = 2 it + sl: its activations au (member 0) and scales ad
    shl.b32 cs, itr, 1;
    add.u32 cs, cs, sl;
    mad.lo.u32 au, cs, 272, act;
    shl.b32 t0, cs, 5;
    add.u32 ad, ad0, t0;
    // both matrices' segments: lane sl loads the 10 aligned 8-byte units from (segment & ~7) + 72 sl
    mul.lo.u32 sego, itr, 148;
    cvt.u64.u32 w64, sego;
    add.u64 seg, rw0, w64;
    and.b64 seg, seg, -8;
    add.u64 seg, seg, sl64;
    ld.global.nc.v2.u32 {u0_0, u0_1}, [seg+0];
    ld.global.nc.v2.u32 {u0_2, u0_3}, [seg+8];
    ld.global.nc.v2.u32 {u0_4, u0_5}, [seg+16];
    ld.global.nc.v2.u32 {u0_6, u0_7}, [seg+24];
    ld.global.nc.v2.u32 {u0_8, u0_9}, [seg+32];
    ld.global.nc.v2.u32 {u0_10, u0_11}, [seg+40];
    ld.global.nc.v2.u32 {u0_12, u0_13}, [seg+48];
    ld.global.nc.v2.u32 {u0_14, u0_15}, [seg+56];
    ld.global.nc.v2.u32 {u0_16, u0_17}, [seg+64];
    ld.global.nc.v2.u32 {u0_18, u0_19}, [seg+72];
    add.u64 seg, rw1, w64;
    and.b64 seg, seg, -8;
    add.u64 seg, seg, sl64;
    ld.global.nc.v2.u32 {u1_0, u1_1}, [seg+0];
    ld.global.nc.v2.u32 {u1_2, u1_3}, [seg+8];
    ld.global.nc.v2.u32 {u1_4, u1_5}, [seg+16];
    ld.global.nc.v2.u32 {u1_6, u1_7}, [seg+24];
    ld.global.nc.v2.u32 {u1_8, u1_9}, [seg+32];
    ld.global.nc.v2.u32 {u1_10, u1_11}, [seg+40];
    ld.global.nc.v2.u32 {u1_12, u1_13}, [seg+48];
    ld.global.nc.v2.u32 {u1_14, u1_15}, [seg+56];
    ld.global.nc.v2.u32 {u1_16, u1_17}, [seg+64];
    ld.global.nc.v2.u32 {u1_18, u1_19}, [seg+72];
    // the words of each super-block after its d, by kappa (warp-uniform): w<m>_k = bytes 2 + 4k .. 5 + 4k
    add.u32 kap, kap0, itr;
    and.b32 kap, kap, 1;
    setp.eq.u32 p0, kap, 0;
    @p0 bra.uni N1_KAPPA0;
    prmt.b32 w0_0, u0_1, u0_2, sel;
    prmt.b32 w0_1, u0_2, u0_3, sel;
    prmt.b32 w0_2, u0_3, u0_4, sel;
    prmt.b32 w0_3, u0_4, u0_5, sel;
    prmt.b32 w0_4, u0_5, u0_6, sel;
    prmt.b32 w0_5, u0_6, u0_7, sel;
    prmt.b32 w0_6, u0_7, u0_8, sel;
    prmt.b32 w0_7, u0_8, u0_9, sel;
    prmt.b32 w0_8, u0_9, u0_10, sel;
    prmt.b32 w0_9, u0_10, u0_11, sel;
    prmt.b32 w0_10, u0_11, u0_12, sel;
    prmt.b32 w0_11, u0_12, u0_13, sel;
    prmt.b32 w0_12, u0_13, u0_14, sel;
    prmt.b32 w0_13, u0_14, u0_15, sel;
    prmt.b32 w0_14, u0_15, u0_16, sel;
    prmt.b32 w0_15, u0_16, u0_17, sel;
    prmt.b32 w0_16, u0_17, u0_18, sel;
    prmt.b32 w0_17, u0_18, u0_19, sel;
    mov.b32 dw0, u0_1;
    prmt.b32 w1_0, u1_1, u1_2, sel;
    prmt.b32 w1_1, u1_2, u1_3, sel;
    prmt.b32 w1_2, u1_3, u1_4, sel;
    prmt.b32 w1_3, u1_4, u1_5, sel;
    prmt.b32 w1_4, u1_5, u1_6, sel;
    prmt.b32 w1_5, u1_6, u1_7, sel;
    prmt.b32 w1_6, u1_7, u1_8, sel;
    prmt.b32 w1_7, u1_8, u1_9, sel;
    prmt.b32 w1_8, u1_9, u1_10, sel;
    prmt.b32 w1_9, u1_10, u1_11, sel;
    prmt.b32 w1_10, u1_11, u1_12, sel;
    prmt.b32 w1_11, u1_12, u1_13, sel;
    prmt.b32 w1_12, u1_13, u1_14, sel;
    prmt.b32 w1_13, u1_14, u1_15, sel;
    prmt.b32 w1_14, u1_15, u1_16, sel;
    prmt.b32 w1_15, u1_16, u1_17, sel;
    prmt.b32 w1_16, u1_17, u1_18, sel;
    prmt.b32 w1_17, u1_18, u1_19, sel;
    mov.b32 dw1, u1_1;
    bra.uni N1_WORDS;
N1_KAPPA0:
    prmt.b32 w0_0, u0_0, u0_1, sel;
    prmt.b32 w0_1, u0_1, u0_2, sel;
    prmt.b32 w0_2, u0_2, u0_3, sel;
    prmt.b32 w0_3, u0_3, u0_4, sel;
    prmt.b32 w0_4, u0_4, u0_5, sel;
    prmt.b32 w0_5, u0_5, u0_6, sel;
    prmt.b32 w0_6, u0_6, u0_7, sel;
    prmt.b32 w0_7, u0_7, u0_8, sel;
    prmt.b32 w0_8, u0_8, u0_9, sel;
    prmt.b32 w0_9, u0_9, u0_10, sel;
    prmt.b32 w0_10, u0_10, u0_11, sel;
    prmt.b32 w0_11, u0_11, u0_12, sel;
    prmt.b32 w0_12, u0_12, u0_13, sel;
    prmt.b32 w0_13, u0_13, u0_14, sel;
    prmt.b32 w0_14, u0_14, u0_15, sel;
    prmt.b32 w0_15, u0_15, u0_16, sel;
    prmt.b32 w0_16, u0_16, u0_17, sel;
    prmt.b32 w0_17, u0_17, u0_18, sel;
    mov.b32 dw0, u0_0;
    prmt.b32 w1_0, u1_0, u1_1, sel;
    prmt.b32 w1_1, u1_1, u1_2, sel;
    prmt.b32 w1_2, u1_2, u1_3, sel;
    prmt.b32 w1_3, u1_3, u1_4, sel;
    prmt.b32 w1_4, u1_4, u1_5, sel;
    prmt.b32 w1_5, u1_5, u1_6, sel;
    prmt.b32 w1_6, u1_6, u1_7, sel;
    prmt.b32 w1_7, u1_7, u1_8, sel;
    prmt.b32 w1_8, u1_8, u1_9, sel;
    prmt.b32 w1_9, u1_9, u1_10, sel;
    prmt.b32 w1_10, u1_10, u1_11, sel;
    prmt.b32 w1_11, u1_11, u1_12, sel;
    prmt.b32 w1_12, u1_12, u1_13, sel;
    prmt.b32 w1_13, u1_13, u1_14, sel;
    prmt.b32 w1_14, u1_14, u1_15, sel;
    prmt.b32 w1_15, u1_15, u1_16, sel;
    prmt.b32 w1_16, u1_16, u1_17, sel;
    prmt.b32 w1_17, u1_17, u1_18, sel;
    mov.b32 dw1, u1_0;
N1_WORDS:
    mov.f32 sf0_0, 0f00000000;
    mov.f32 sf0_1, 0f00000000;
    // blocks 0..3: the scales as bytes 2 s + 1
    shl.b32 ts, w0_16, 1;
    lop3.b32 e0_0, ts, K1E, K01, 0xEA;  // ((sw << 1) & 0x1E1E1E1E) | 0x01010101: 2 ls0 + 1
    shr.b32 ts, w0_16, 3;
    lop3.b32 e1_0, ts, K1E, K01, 0xEA;  // ((sw >> 3) & 0x1E1E1E1E) | 0x01010101: 2 ls1 + 1
    shl.b32 ts, w1_16, 1;
    lop3.b32 e0_1, ts, K1E, K01, 0xEA;  // ((sw << 1) & 0x1E1E1E1E) | 0x01010101: 2 ls0 + 1
    shr.b32 ts, w1_16, 3;
    lop3.b32 e1_1, ts, K1E, K01, 0xEA;  // ((sw >> 3) & 0x1E1E1E1E) | 0x01010101: 2 ls1 + 1
    // block 0: weights 0..31
    bfe.u32 s7, w0_0, 9, 7;
    shl.b32 t6, s7, 6;
    lop3.b32 x, s7, t6, K3333, 0xA8;   // (s7 | s7 << 6) & 0x3333
    popc.b32 pc, s7;
    bfi.b32 x, pc, x, 13, 1;          // the eighth sign: the parity of the seven
    prmt.b32 sn, LS, ZERO, x;
    bfi.b32 ea, w0_0, coff, 5, 9;       // the 9-bit grid index at bits 5-13, the copy at 2-4
    add.u32 ea, ea, tabb;
    ld.shared.u32 cw, [ea];
    or.b32 sv, cw, sn;
    prmt.b32 q0_0, LP, LN, sv;
    shr.b32 sh, sv, 16;
    prmt.b32 q0_1, LP, LN, sh;
    bfe.u32 s7, w0_0, 25, 7;
    shl.b32 t6, s7, 6;
    lop3.b32 x, s7, t6, K3333, 0xA8;   // (s7 | s7 << 6) & 0x3333
    popc.b32 pc, s7;
    bfi.b32 x, pc, x, 13, 1;          // the eighth sign: the parity of the seven
    prmt.b32 sn, LS, ZERO, x;
    shr.b32 hi, w0_0, 16;
    bfi.b32 ea, hi, coff, 5, 9;       // the 9-bit grid index at bits 5-13, the copy at 2-4
    add.u32 ea, ea, tabb;
    ld.shared.u32 cw, [ea];
    or.b32 sv, cw, sn;
    prmt.b32 q0_2, LP, LN, sv;
    shr.b32 sh, sv, 16;
    prmt.b32 q0_3, LP, LN, sh;
    bfe.u32 s7, w0_1, 9, 7;
    shl.b32 t6, s7, 6;
    lop3.b32 x, s7, t6, K3333, 0xA8;   // (s7 | s7 << 6) & 0x3333
    popc.b32 pc, s7;
    bfi.b32 x, pc, x, 13, 1;          // the eighth sign: the parity of the seven
    prmt.b32 sn, LS, ZERO, x;
    bfi.b32 ea, w0_1, coff, 5, 9;       // the 9-bit grid index at bits 5-13, the copy at 2-4
    add.u32 ea, ea, tabb;
    ld.shared.u32 cw, [ea];
    or.b32 sv, cw, sn;
    prmt.b32 q0_4, LP, LN, sv;
    shr.b32 sh, sv, 16;
    prmt.b32 q0_5, LP, LN, sh;
    bfe.u32 s7, w0_1, 25, 7;
    shl.b32 t6, s7, 6;
    lop3.b32 x, s7, t6, K3333, 0xA8;   // (s7 | s7 << 6) & 0x3333
    popc.b32 pc, s7;
    bfi.b32 x, pc, x, 13, 1;          // the eighth sign: the parity of the seven
    prmt.b32 sn, LS, ZERO, x;
    shr.b32 hi, w0_1, 16;
    bfi.b32 ea, hi, coff, 5, 9;       // the 9-bit grid index at bits 5-13, the copy at 2-4
    add.u32 ea, ea, tabb;
    ld.shared.u32 cw, [ea];
    or.b32 sv, cw, sn;
    prmt.b32 q0_6, LP, LN, sv;
    shr.b32 sh, sv, 16;
    prmt.b32 q0_7, LP, LN, sh;
    bfe.u32 ts, e0_0, 0, 8;
    cvt.rn.f32.u32 fl0_0, ts;           // 2 ls0 + 1
    bfe.u32 ts, e1_0, 0, 8;
    cvt.rn.f32.u32 fl1_0, ts;           // 2 ls1 + 1
    mul.ftz.f32 nc1_0, fl1_0, 0fCB400000;  // -(2 ls1 + 1) * 1.5 * 2^23
    bfe.u32 s7, w1_0, 9, 7;
    shl.b32 t6, s7, 6;
    lop3.b32 x, s7, t6, K3333, 0xA8;   // (s7 | s7 << 6) & 0x3333
    popc.b32 pc, s7;
