    bra.uni N6_WORDS;
N6_KAPPA2:
    prmt.b32 w0_0, u0_2, u0_3, sel;
    prmt.b32 w0_1, u0_3, u0_4, sel;
    prmt.b32 w0_2, u0_4, u0_5, sel;
    prmt.b32 w0_3, u0_5, u0_6, sel;
    prmt.b32 w0_4, u0_6, u0_7, sel;
    prmt.b32 w0_5, u0_7, u0_8, sel;
    prmt.b32 w0_6, u0_8, u0_9, sel;
    prmt.b32 w0_7, u0_9, u0_10, sel;
    prmt.b32 w0_8, u0_10, u0_11, sel;
    prmt.b32 w0_9, u0_11, u0_12, sel;
    prmt.b32 w0_10, u0_12, u0_13, sel;
    prmt.b32 w0_11, u0_13, u0_14, sel;
    prmt.b32 w0_12, u0_14, u0_15, sel;
    prmt.b32 w0_13, u0_15, u0_16, sel;
    prmt.b32 w0_14, u0_16, u0_17, sel;
    prmt.b32 w0_15, u0_17, u0_18, sel;
    mov.b32 dw0, u0_2;
    prmt.b32 w1_0, u1_2, u1_3, sel;
    prmt.b32 w1_1, u1_3, u1_4, sel;
    prmt.b32 w1_2, u1_4, u1_5, sel;
    prmt.b32 w1_3, u1_5, u1_6, sel;
    prmt.b32 w1_4, u1_6, u1_7, sel;
    prmt.b32 w1_5, u1_7, u1_8, sel;
    prmt.b32 w1_6, u1_8, u1_9, sel;
    prmt.b32 w1_7, u1_9, u1_10, sel;
    prmt.b32 w1_8, u1_10, u1_11, sel;
    prmt.b32 w1_9, u1_11, u1_12, sel;
