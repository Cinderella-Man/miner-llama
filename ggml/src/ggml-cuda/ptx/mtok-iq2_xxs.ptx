//
// mtok-iq2_xxs.ptx: IQ2_XXS's fast multi-token expert kernel (C1138) in hand-written PTX, written by
// gen_mtok_iq2_xxs.py (do not edit; edit the script). See mmvq-pascal-mtok-iq2_xxs-fast.cu for the method
// and mmvq-pascal-mtok-iq-ptx.cu for how it is loaded and which products it takes.
//
.version 7.0
.target sm_61
.address_size 64

// the IQ2_XXS grid as codes: entry e's eight values (8, 25, 43 -> 0, 1, 2) as nibbles, nibble n weight
// [0, 1, 4, 5, 2, 3, 6, 7][n] of the group
.global .align 4 .b32 mtok_iq2xxs_codes[256] = {
    0x00000000, 0x00000002, 0x00000011, 0x00000020, 0x00000022, 0x00010001, 0x00010010, 0x00020000,
    0x00020002, 0x00020020, 0x00020022, 0x00100001, 0x00100010, 0x00110000, 0x00110020, 0x00120001,
    0x00120010, 0x00200000, 0x00200002, 0x00200022, 0x00220002, 0x00000101, 0x00000110, 0x00010100,
    0x00010111, 0x00100100, 0x00200110, 0x00210120, 0x00000200, 0x00000202, 0x00020202, 0x00200202,
    0x00001001, 0x00001010, 0x00011000, 0x00021001, 0x00021010, 0x00101000, 0x00101002, 0x00101020,
    0x00121000, 0x00201001, 0x00201010, 0x00211000, 0x00221010, 0x00001100, 0x00001102, 0x00001120,
    0x00021100, 0x00101112, 0x00121121, 0x00201100, 0x00211101, 0x00001221, 0x00011200, 0x00101200,
    0x00201210, 0x00221210, 0x00002000, 0x00002011, 0x00002020, 0x00012010, 0x00022020, 0x00102001,
    0x00102010, 0x00112000, 0x00112002, 0x00202020, 0x00002110, 0x00102100, 0x00002202, 0x00012210,
    0x01000001, 0x01000010, 0x01010000, 0x01020001, 0x01100000, 0x01120000, 0x01200010, 0x01210000,
    0x01210011, 0x01000100, 0x01000120, 0x01020100, 0x01110100, 0x01110122, 0x01200100, 0x01020210,
    0x01100211, 0x01001000, 0x01001020, 0x01021000, 0x01021011, 0x01101021, 0x01201000, 0x01011120,
    0x01121102, 0x01001200, 0x01011212, 0x01002001, 0x01002010, 0x01012000, 0x01102000, 0x01202001,
    0x01002100, 0x01002111, 0x01222100, 0x01112201, 0x02000000, 0x02000002, 0x02000022, 0x02100010,
    0x02120001, 0x02200000, 0x02200002, 0x02020121, 0x02100120, 0x02000200, 0x02000202, 0x02001001,
    0x02001010, 0x02011000, 0x02101000, 0x02111012, 0x02001100, 0x02101101, 0x02121110, 0x02211200,
    0x02002020, 0x02022000, 0x02212010, 0x02102210, 0x10000001, 0x10000010, 0x10010000, 0x10010020,
    0x10020001, 0x10020010, 0x10100000, 0x10100020, 0x10110012, 0x10120000, 0x10200001, 0x10200010,
    0x10210000, 0x10000100, 0x10020100, 0x10120101, 0x10200100, 0x10200111, 0x10000201, 0x10010200,
    0x10100220, 0x10110212, 0x10120220, 0x10001000, 0x10001020, 0x10021000, 0x10201000, 0x10211021,
    0x10011102, 0x10021110, 0x10001200, 0x10002001, 0x10002010, 0x10012000, 0x10102000, 0x10102011,
    0x10002100, 0x10112120, 0x10122101, 0x10202102, 0x10102211, 0x10212200, 0x11000000, 0x11000020,
    0x11010001, 0x11010021, 0x11020000, 0x11200000, 0x11200020, 0x11000110, 0x11100102, 0x11220110,
    0x11210201, 0x11211000, 0x11211002, 0x11001122, 0x11001201, 0x11111210, 0x11002000, 0x11012001,
    0x11012021, 0x11122010, 0x11102100, 0x11002220, 0x12000010, 0x12010000, 0x12100000, 0x12120020,
    0x12000100, 0x12110111, 0x12010220, 0x12120200, 0x12001000, 0x12001011, 0x12011100, 0x12011102,
    0x12201110, 0x12102002, 0x20000000, 0x20000002, 0x20000022, 0x20100001, 0x20200002, 0x20000110,
    0x20010120, 0x20100100, 0x20010201, 0x20001001, 0x20001010, 0x20011000, 0x20011011, 0x20101000,
    0x20121000, 0x20001100, 0x20101112, 0x20211110, 0x20001221, 0x20101200, 0x20121200, 0x20002002,
    0x20002110, 0x20012201, 0x21000010, 0x21010000, 0x21020010, 0x21100000, 0x21220001, 0x21010112,
    0x21200100, 0x21100211, 0x21001000, 0x21021002, 0x21101010, 0x21111101, 0x21202001, 0x21022100,
    0x22000002, 0x22110000, 0x22200011, 0x22000121, 0x22000200, 0x22011020, 0x22112000, 0x22002110
};
.extern .shared .align 16 .b8 mtok_iq2xxs_dyn[];

.visible .entry mtok_iq2xxs_fast_ptx_ntm2(
    .param .align 8 .b8 P[168],
    .param .align 8 .b8 F[80]
)
.maxntid 128, 1, 1
.minnctapersm 3
{
    .reg .pred p0, p1, p2, p3, p4, pq, psl, pst;
    .reg .b16 h0, h1;
    .reg .b32 lane, warp, bx, by, bz, tid, nrows, row_bytes, nrowblocks, rb, gcap, ncols;
    .reg .b32 nslots, ids_stride, act_tok, ncy_x, ncy_y, ncy_z, sr_x, sr_y, t0, t1, t2, t3;
    .reg .b32 sx, ne, ty, ky, ey, idx, rank, i, v, bal, cnt, mk0;
    .reg .b32 mk1, mk2, mk3, total, hsel, rr, msk, nt, yoff, doff, bit, kk;
    .reg .b32 chy, tabb, e, cw, sa, act, jm, yj, aj, drel, srel, pa0;
    .reg .b32 pa1, pa2, pa3, y0, y1, y2, y3, y4, y5, y6, y7, y8;
    .reg .b32 sl, grp, sel, tabl, ad0, rbx, LP, LN, LS, K3333, ZERO, DBASE;
    .reg .b32 dc0, rbi, rblk, row0, rowc, kap0, kap, itr, cs, au, ad, sego;
    .reg .b32 u0_0, u0_1, u0_2, u0_3, u0_4, u0_5, u0_6, u0_7, u0_8, u0_9, u0_10, u0_11;
    .reg .b32 u0_12, u0_13, u0_14, u0_15, u0_16, u0_17, u0_18, u0_19, u1_0, u1_1, u1_2, u1_3;
    .reg .b32 u1_4, u1_5, u1_6, u1_7, u1_8, u1_9, u1_10, u1_11, u1_12, u1_13, u1_14, u1_15;
    .reg .b32 u1_16, u1_17, u1_18, u1_19, w0_0, w0_1, w0_2, w0_3, w0_4, w0_5, w0_6, w0_7;
    .reg .b32 w0_8, w0_9, w0_10, w0_11, w0_12, w0_13, w0_14, w0_15, dw0, w1_0, w1_1, w1_2;
    .reg .b32 w1_3, w1_4, w1_5, w1_6, w1_7, w1_8, w1_9, w1_10, w1_11, w1_12, w1_13, w1_14;
    .reg .b32 w1_15, dw1, s7, t6, x, pc, sg, eo, ea, cw2, sv, sh;
    .reg .b32 ia, q0_0, q0_1, q0_2, q0_3, q0_4, q0_5, q0_6, q0_7, q1_0, q1_1, q1_2;
    .reg .b32 q1_3, q1_4, q1_5, q1_6, q1_7, ua0, ua1, ua2, ua3, ub0, ub1, ub2;
    .reg .b32 ub3, dsh, rt0, rt1, dc1, au1, ad1;
    .reg .b64 vx, vy, ids, dstp, gatep, chbx, smbx, chby, smby, colby, scd, ssd;
    .reg .b64 scold, a64, o64, w64, x64, cods, xo, xu, xg, sl64, rw0, rw1;
    .reg .b64 ro64, seg, dsk;
    .reg .f32 fsc, acc0_0, acc0_1, sf0_0, sf0_1, fl0, fl1, nc0, nc1, fa, fi, fp;
    .reg .f32 fd, fs, fu, fg, fe, acc1_0, acc1_1, sf1_0, sf1_1;
    .shared .align 16 .b32 tab[2048];

    // thread, block and parameters
    mov.u32 lane, %tid.x;
    mov.u32 warp, %tid.y;
    mov.u32 bx, %ctaid.x;
    mov.u32 by, %ctaid.y;
    mov.u32 bz, %ctaid.z;
    mad.lo.u32 tid, warp, 32, lane;
    ld.param.u64 vx, [P+0];
    cvta.to.global.u64 vx, vx;
    ld.param.u64 vy, [P+8];
    cvta.to.global.u64 vy, vy;
    ld.param.u64 ids, [P+16];
    cvta.to.global.u64 ids, ids;
    ld.param.u64 dstp, [P+24];
    cvta.to.global.u64 dstp, dstp;
    ld.param.u64 gatep, [F+8];
    cvta.to.global.u64 gatep, gatep;
    ld.param.u32 nrows, [P+32];
    ld.param.u32 row_bytes, [P+36];
    ld.param.u32 nrowblocks, [P+48];
    ld.param.u32 rb, [P+52];
    ld.param.u32 gcap, [P+56];
    ld.param.u32 ncols, [P+60];
    ld.param.u32 nslots, [P+64];
    ld.param.u32 ids_stride, [P+68];
    ld.param.u32 act_tok, [P+76];
    ld.param.u32 ncy_x, [P+80];
    ld.param.u32 ncy_y, [P+84];
    ld.param.u32 ncy_z, [P+88];
    ld.param.u32 sr_x, [P+92];
    ld.param.u32 sr_y, [P+96];
    ld.param.u64 chbx, [P+104];
    ld.param.u64 smbx, [P+112];
    ld.param.u64 chby, [P+120];
    ld.param.u64 smby, [P+128];
    ld.param.u64 colby, [P+136];
    ld.param.u64 scd, [P+144];
    ld.param.u64 ssd, [P+152];
    ld.param.u64 scold, [P+160];
    // sample_x = fastdiv(blockIdx.z, sample_ratio)
    mul.hi.u32 t0, bz, sr_x;
    add.u32 t0, t0, bz;
    shr.b32 sx, t0, sr_y;

    // the block's group (mtok_iq::group): entry blockIdx.y = token ty, slot ky; its expert ey
    mul.lo.u32 ne, ncols, nslots;
    div.u32 ty, by, nslots;
    mul.lo.u32 t0, ty, nslots;
    sub.u32 ky, by, t0;
    mad.lo.u32 idx, ty, ids_stride, ky;
    mul.wide.u32 o64, idx, 4;
    add.u64 a64, ids, o64;
    ld.global.s32 ey, [a64];
    setp.lt.s32 p0, ey, 0;
    @p0 bra.uni SKIPPED;
    // rank: the entries before this one with the same expert; mk<h>: those from it on, 32 entries a word
    mov.u32 rank, 0;
    add.u32 i, lane, 0;
    div.u32 t0, i, nslots;
    mul.lo.u32 t1, t0, nslots;
    sub.u32 t1, i, t1;
    mad.lo.u32 idx, t0, ids_stride, t1;
    mul.wide.u32 o64, idx, 4;
    add.u64 a64, ids, o64;
    setp.lt.u32 p1, i, ne;
    mov.u32 v, -1;
    @p1 ld.global.s32 v, [a64];
    setp.eq.s32 p2, v, ey;
    setp.lt.u32 p3, i, by;
    and.pred p4, p2, p3;
    vote.sync.ballot.b32 bal, p4, -1;
    popc.b32 cnt, bal;
    add.u32 rank, rank, cnt;
    setp.ge.u32 p3, i, by;
    and.pred p4, p2, p3;
    vote.sync.ballot.b32 mk0, p4, -1;
    add.u32 i, lane, 32;
    div.u32 t0, i, nslots;
    mul.lo.u32 t1, t0, nslots;
    sub.u32 t1, i, t1;
    mad.lo.u32 idx, t0, ids_stride, t1;
    mul.wide.u32 o64, idx, 4;
    add.u64 a64, ids, o64;
    setp.lt.u32 p1, i, ne;
    mov.u32 v, -1;
    @p1 ld.global.s32 v, [a64];
    setp.eq.s32 p2, v, ey;
    setp.lt.u32 p3, i, by;
    and.pred p4, p2, p3;
    vote.sync.ballot.b32 bal, p4, -1;
    popc.b32 cnt, bal;
    add.u32 rank, rank, cnt;
    setp.ge.u32 p3, i, by;
    and.pred p4, p2, p3;
    vote.sync.ballot.b32 mk1, p4, -1;
    add.u32 i, lane, 64;
    div.u32 t0, i, nslots;
    mul.lo.u32 t1, t0, nslots;
    sub.u32 t1, i, t1;
    mad.lo.u32 idx, t0, ids_stride, t1;
    mul.wide.u32 o64, idx, 4;
    add.u64 a64, ids, o64;
    setp.lt.u32 p1, i, ne;
    mov.u32 v, -1;
    @p1 ld.global.s32 v, [a64];
    setp.eq.s32 p2, v, ey;
    setp.lt.u32 p3, i, by;
    and.pred p4, p2, p3;
    vote.sync.ballot.b32 bal, p4, -1;
    popc.b32 cnt, bal;
    add.u32 rank, rank, cnt;
    setp.ge.u32 p3, i, by;
    and.pred p4, p2, p3;
    vote.sync.ballot.b32 mk2, p4, -1;
    add.u32 i, lane, 96;
    div.u32 t0, i, nslots;
    mul.lo.u32 t1, t0, nslots;
    sub.u32 t1, i, t1;
    mad.lo.u32 idx, t0, ids_stride, t1;
    mul.wide.u32 o64, idx, 4;
    add.u64 a64, ids, o64;
    setp.lt.u32 p1, i, ne;
    mov.u32 v, -1;
    @p1 ld.global.s32 v, [a64];
    setp.eq.s32 p2, v, ey;
    setp.lt.u32 p3, i, by;
    and.pred p4, p2, p3;
    vote.sync.ballot.b32 bal, p4, -1;
    popc.b32 cnt, bal;
    add.u32 rank, rank, cnt;
    setp.ge.u32 p3, i, by;
    and.pred p4, p2, p3;
    vote.sync.ballot.b32 mk3, p4, -1;
    rem.u32 t0, rank, gcap;
    setp.ne.u32 p0, t0, 0;
    @p0 bra.uni DONE;
    // lane j < nt finds the group's member j: the j-th set bit of mk0..mk3
    mov.u32 total, 0;
    mov.u32 hsel, 4;
    mov.u32 rr, 0;
    mov.u32 msk, 0;
    popc.b32 cnt, mk0;
    add.u32 t0, total, cnt;
    setp.eq.u32 p1, hsel, 4;
    setp.lt.u32 p2, lane, t0;
    and.pred p3, p1, p2;
    @p3 mov.u32 hsel, 0;
    @p3 sub.u32 rr, lane, total;
    @p3 mov.u32 msk, mk0;
    mov.u32 total, t0;
    popc.b32 cnt, mk1;
    add.u32 t0, total, cnt;
    setp.eq.u32 p1, hsel, 4;
    setp.lt.u32 p2, lane, t0;
    and.pred p3, p1, p2;
    @p3 mov.u32 hsel, 1;
    @p3 sub.u32 rr, lane, total;
    @p3 mov.u32 msk, mk1;
    mov.u32 total, t0;
    popc.b32 cnt, mk2;
    add.u32 t0, total, cnt;
    setp.eq.u32 p1, hsel, 4;
    setp.lt.u32 p2, lane, t0;
    and.pred p3, p1, p2;
    @p3 mov.u32 hsel, 2;
    @p3 sub.u32 rr, lane, total;
    @p3 mov.u32 msk, mk2;
    mov.u32 total, t0;
    popc.b32 cnt, mk3;
    add.u32 t0, total, cnt;
    setp.eq.u32 p1, hsel, 4;
    setp.lt.u32 p2, lane, t0;
    and.pred p3, p1, p2;
    @p3 mov.u32 hsel, 3;
    @p3 sub.u32 rr, lane, total;
    @p3 mov.u32 msk, mk3;
    mov.u32 total, t0;
    min.u32 nt, gcap, total;
    mov.u32 yoff, 0;
    mov.u32 doff, 0;
    setp.ge.u32 p1, lane, nt;
    @p1 bra MEMBER_DONE;
DROP_BITS:
    setp.eq.u32 p2, rr, 0;
    @p2 bra DROPPED;
    add.u32 t0, msk, -1;
    and.b32 msk, msk, t0;
    sub.u32 rr, rr, 1;
    bra DROP_BITS;
DROPPED:
    neg.s32 t0, msk;
    and.b32 t0, msk, t0;
    bfind.u32 bit, t0;
    shl.b32 i, hsel, 5;
    add.u32 i, i, bit;
    div.u32 t0, i, nslots;
    mul.lo.u32 t1, t0, nslots;
    sub.u32 kk, i, t1;
    // channel_y = fastmodulo(k, nchannels_y)
    mul.hi.u32 t2, kk, ncy_x;
    add.u32 t2, t2, kk;
    shr.b32 t2, t2, ncy_y;
    mul.lo.u32 t2, t2, ncy_z;
    sub.u32 chy, kk, t2;
    // yoff = sample * sample_bytes_y + channel_y * channel_bytes_y + token * col_bytes_y (fits an int)
    cvt.u64.u32 w64, bz;
    mul.lo.u64 x64, w64, smby;
    cvt.u64.u32 w64, chy;
    mad.lo.u64 x64, w64, chby, x64;
    cvt.u64.u32 w64, t0;
    mad.lo.u64 x64, w64, colby, x64;
    cvt.u32.u64 yoff, x64;
    // doff = sample * stride_sample_dst + slot * stride_channel_dst + token * stride_col_dst
    cvt.u64.u32 w64, bz;
    mul.lo.u64 x64, w64, ssd;
    cvt.u64.u32 w64, kk;
    mad.lo.u64 x64, w64, scd, x64;
    cvt.u64.u32 w64, t0;
    mad.lo.u64 x64, w64, scold, x64;
    cvt.u32.u64 doff, x64;
MEMBER_DONE:

    // the code table: entry e's eight codes (0, 1, 2 for 8, 25, 43) as nibbles, 8 copies interleaved by word
    mov.u32 tabb, tab;
    mov.u64 cods, mtok_iq2xxs_codes;
    add.u32 e, tid, 0;
    mul.wide.u32 o64, e, 4;
    add.u64 a64, cods, o64;
    ld.global.nc.u32 cw, [a64];
    shl.b32 sa, e, 5;
    add.u32 sa, sa, tabb;
    st.shared.v4.u32 [sa], {cw, cw, cw, cw};
    st.shared.v4.u32 [sa+16], {cw, cw, cw, cw};
    add.u32 e, tid, 128;
    mul.wide.u32 o64, e, 4;
    add.u64 a64, cods, o64;
    ld.global.nc.u32 cw, [a64];
    shl.b32 sa, e, 5;
    add.u32 sa, sa, tabb;
    st.shared.v4.u32 [sa], {cw, cw, cw, cw};
    st.shared.v4.u32 [sa+16], {cw, cw, cw, cw};
    // the members' activations: each group of 8 int8 values as (0, 1, 4, 5), (2, 3, 6, 7); thread q < 80 stages
    // Q8_1 block q of each member: 256 values and 16 bytes of padding per super-block, the FP32 scales after them
    mov.u32 act, mtok_iq2xxs_dyn;
    setp.lt.u32 pq, tid, 80;
    shr.b32 t0, tid, 3;
    and.b32 t1, tid, 7;
    shl.b32 t1, t1, 5;
    mad.lo.u32 drel, t0, 272, t1;
    shl.b32 srel, tid, 2;
    add.u32 srel, srel, 2720;
    mul.wide.u32 w64, tid, 36;
    mov.u32 jm, 0;
STAGE_MEMBER:
    setp.ge.u32 p0, jm, nt;
    @p0 bra.uni STAGED;
    shfl.sync.idx.b32 yj, yoff, jm, 31, -1;
    mad.lo.u32 aj, jm, act_tok, act;
    cvt.s64.s32 x64, yj;
    add.u64 a64, vy, x64;
    add.u64 a64, a64, w64;
    @pq ld.global.nc.u32 y0, [a64+0];
    @pq ld.global.nc.u32 y1, [a64+4];
    @pq ld.global.nc.u32 y2, [a64+8];
    @pq ld.global.nc.u32 y3, [a64+12];
    @pq ld.global.nc.u32 y4, [a64+16];
    @pq ld.global.nc.u32 y5, [a64+20];
    @pq ld.global.nc.u32 y6, [a64+24];
    @pq ld.global.nc.u32 y7, [a64+28];
    @pq ld.global.nc.u32 y8, [a64+32];
    add.u32 sa, aj, drel;
    prmt.b32 pa0, y1, y2, 0x5410;
    prmt.b32 pa1, y1, y2, 0x7632;
    prmt.b32 pa2, y3, y4, 0x5410;
    prmt.b32 pa3, y3, y4, 0x7632;
    @pq st.shared.v4.u32 [sa], {pa0, pa1, pa2, pa3};
    prmt.b32 pa0, y5, y6, 0x5410;
    prmt.b32 pa1, y5, y6, 0x7632;
    prmt.b32 pa2, y7, y8, 0x5410;
    prmt.b32 pa3, y7, y8, 0x7632;
    @pq st.shared.v4.u32 [sa+16], {pa0, pa1, pa2, pa3};
    mov.b32 {h0, h1}, y0;
    cvt.f32.f16 fsc, h0;
    add.u32 sa, aj, srel;
    @pq st.shared.f32 [sa], fsc;
    add.u32 jm, jm, 1;
    bra.uni STAGE_MEMBER;
STAGED:
    bar.sync 0;

    // the expert's up and gate matrices; constants
    cvt.u64.u32 w64, sx;
    mul.lo.u64 xo, w64, smbx;
    cvt.u64.u32 w64, ey;
    mad.lo.u64 xo, w64, chbx, xo;
    add.u64 xu, vx, xo;
    add.u64 xg, gatep, xo;
    and.b32 sl, lane, 1;
    shr.b32 grp, lane, 1;
    setp.ne.u32 psl, sl, 0;
    selp.b32 sel, 0x7654, 0x5432, psl;
    and.b32 t0, lane, 7;
    shl.b32 t0, t0, 2;
    add.u32 tabl, tabb, t0;
    add.u32 ad0, act, 2720;
    mul.lo.u32 rbx, bx, rb;
    mul.wide.u32 sl64, sl, 64;
    mov.b32 LP, 0x002b1908;    // bytes 8, 25, 43, 0: the grid values by code
    mov.b32 LN, 0x00d5e7f8;    // -8, -25, -43, 0
    mov.b32 LS, 0x44400400;    // two sign bits (index b0 + 2 b1) -> bit 2 of two nibbles
    mov.b32 K3333, 0x3333;
    mov.b32 ZERO, 0;
