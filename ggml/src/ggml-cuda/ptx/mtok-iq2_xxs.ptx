    prmt.b32 w1_14, u1_16, u1_17, sel;
    prmt.b32 w1_15, u1_17, u1_18, sel;
    mov.b32 dw1, u1_2;
N2_WORDS:
    mov.f32 sf0_0, 0f00000000;
    mov.f32 sf0_1, 0f00000000;
    mov.f32 sf1_0, 0f00000000;
