    shl.b32 eo, eo, 5;
    add.u32 ea, tabl, eo;
    ld.shared.u32 cw2, [ea];
    or.b32 sv, cw2, sg;
    prmt.b32 q0_4, LP, LN, sv;
    shr.b32 sh, sv, 16;
    prmt.b32 q0_5, LP, LN, sh;
    bfe.u32 s7, w0_1, 21, 7;
    shl.b32 t6, s7, 6;
