    shl.b32 t6, s7, 6;
    lop3.b32 x, s7, t6, K3333, 0xA8;   // (s7 | s7 << 6) & 0x3333
    popc.b32 pc, s7;
    bfi.b32 x, pc, x, 13, 1;          // the eighth sign: the parity of the seven
    prmt.b32 sg, LS, ZERO, x;
    bfe.u32 eo, w1_12, 0, 8;
    shl.b32 eo, eo, 5;
    add.u32 ea, tabl, eo;
    ld.shared.u32 cw2, [ea];
    or.b32 sv, cw2, sg;
    prmt.b32 q1_0, LP, LN, sv;
    shr.b32 sh, sv, 16;
    prmt.b32 q1_1, LP, LN, sh;
    bfe.u32 s7, w1_13, 7, 7;
    shl.b32 t6, s7, 6;
    lop3.b32 x, s7, t6, K3333, 0xA8;   // (s7 | s7 << 6) & 0x3333
    popc.b32 pc, s7;
    bfi.b32 x, pc, x, 13, 1;          // the eighth sign: the parity of the seven
    prmt.b32 sg, LS, ZERO, x;
    bfe.u32 eo, w1_12, 8, 8;
    shl.b32 eo, eo, 5;
    add.u32 ea, tabl, eo;
    ld.shared.u32 cw2, [ea];
    or.b32 sv, cw2, sg;
    prmt.b32 q1_2, LP, LN, sv;
    shr.b32 sh, sv, 16;
    prmt.b32 q1_3, LP, LN, sh;
    bfe.u32 s7, w1_13, 14, 7;
    shl.b32 t6, s7, 6;
    lop3.b32 x, s7, t6, K3333, 0xA8;   // (s7 | s7 << 6) & 0x3333
    popc.b32 pc, s7;
    bfi.b32 x, pc, x, 13, 1;          // the eighth sign: the parity of the seven
    prmt.b32 sg, LS, ZERO, x;
    bfe.u32 eo, w1_12, 16, 8;
    shl.b32 eo, eo, 5;
    add.u32 ea, tabl, eo;
    ld.shared.u32 cw2, [ea];
    or.b32 sv, cw2, sg;
    prmt.b32 q1_4, LP, LN, sv;
    shr.b32 sh, sv, 16;
    prmt.b32 q1_5, LP, LN, sh;
    bfe.u32 s7, w1_13, 21, 7;
    shl.b32 t6, s7, 6;
    lop3.b32 x, s7, t6, K3333, 0xA8;   // (s7 | s7 << 6) & 0x3333
    popc.b32 pc, s7;
    bfi.b32 x, pc, x, 13, 1;          // the eighth sign: the parity of the seven
    prmt.b32 sg, LS, ZERO, x;
    bfe.u32 eo, w1_12, 24, 8;
    shl.b32 eo, eo, 5;
    add.u32 ea, tabl, eo;
    ld.shared.u32 cw2, [ea];
    or.b32 sv, cw2, sg;
    prmt.b32 q1_6, LP, LN, sv;
    shr.b32 sh, sv, 16;
    prmt.b32 q1_7, LP, LN, sh;
    shr.b32 t0, w1_13, 27;
    or.b32 t0, t0, 0x4B000001;
    mov.b32 fl1, t0;
    add.ftz.f32 fl1, fl1, 0fCB000000;  // 2 scale + 1
    mul.ftz.f32 nc1, fl1, 0fCB400000;  // -(2 scale + 1) * 1.5 * 2^23
    ld.shared.v4.u32 {ua0, ua1, ua2, ua3}, [au+192];
    ld.shared.v4.u32 {ub0, ub1, ub2, ub3}, [au+208];
    ld.shared.f32 fa, [ad+24];
    dp4a.s32.s32 ia, q0_0, ua0, DBASE;
    dp4a.s32.s32 ia, q0_1, ua1, ia;
    dp4a.s32.s32 ia, q0_2, ua2, ia;
    dp4a.s32.s32 ia, q0_3, ua3, ia;
    dp4a.s32.s32 ia, q0_4, ub0, ia;
    dp4a.s32.s32 ia, q0_5, ub1, ia;
    dp4a.s32.s32 ia, q0_6, ub2, ia;
    dp4a.s32.s32 ia, q0_7, ub3, ia;
    mov.b32 fi, ia;
    fma.rn.ftz.f32 fp, fl0, fi, nc0;     // (float) (ls * isum), exactly
    fma.rn.ftz.f32 sf0_0, fa, fp, sf0_0;
    dp4a.s32.s32 ia, q1_0, ua0, DBASE;
    dp4a.s32.s32 ia, q1_1, ua1, ia;
    dp4a.s32.s32 ia, q1_2, ua2, ia;
    dp4a.s32.s32 ia, q1_3, ua3, ia;
    dp4a.s32.s32 ia, q1_4, ub0, ia;
    dp4a.s32.s32 ia, q1_5, ub1, ia;
    dp4a.s32.s32 ia, q1_6, ub2, ia;
    dp4a.s32.s32 ia, q1_7, ub3, ia;
    mov.b32 fi, ia;
    fma.rn.ftz.f32 fp, fl1, fi, nc1;     // (float) (ls * isum), exactly
    fma.rn.ftz.f32 sf0_1, fa, fp, sf0_1;
    // block 7: weights 224..255
    bfe.u32 s7, w0_15, 0, 7;
    shl.b32 t6, s7, 6;
    lop3.b32 x, s7, t6, K3333, 0xA8;   // (s7 | s7 << 6) & 0x3333
    popc.b32 pc, s7;
    bfi.b32 x, pc, x, 13, 1;          // the eighth sign: the parity of the seven
    prmt.b32 sg, LS, ZERO, x;
    bfe.u32 eo, w0_14, 0, 8;
    shl.b32 eo, eo, 5;
    add.u32 ea, tabl, eo;
    ld.shared.u32 cw2, [ea];
    or.b32 sv, cw2, sg;
    prmt.b32 q0_0, LP, LN, sv;
    shr.b32 sh, sv, 16;
    prmt.b32 q0_1, LP, LN, sh;
    bfe.u32 s7, w0_15, 7, 7;
    shl.b32 t6, s7, 6;
    lop3.b32 x, s7, t6, K3333, 0xA8;   // (s7 | s7 << 6) & 0x3333
    popc.b32 pc, s7;
    bfi.b32 x, pc, x, 13, 1;          // the eighth sign: the parity of the seven
    prmt.b32 sg, LS, ZERO, x;
    bfe.u32 eo, w0_14, 8, 8;
    shl.b32 eo, eo, 5;
    add.u32 ea, tabl, eo;
    ld.shared.u32 cw2, [ea];
    or.b32 sv, cw2, sg;
    prmt.b32 q0_2, LP, LN, sv;
    shr.b32 sh, sv, 16;
    prmt.b32 q0_3, LP, LN, sh;
    bfe.u32 s7, w0_15, 14, 7;
    shl.b32 t6, s7, 6;
    lop3.b32 x, s7, t6, K3333, 0xA8;   // (s7 | s7 << 6) & 0x3333
    popc.b32 pc, s7;
    bfi.b32 x, pc, x, 13, 1;          // the eighth sign: the parity of the seven
    prmt.b32 sg, LS, ZERO, x;
    bfe.u32 eo, w0_14, 16, 8;
    shl.b32 eo, eo, 5;
    add.u32 ea, tabl, eo;
    ld.shared.u32 cw2, [ea];
    or.b32 sv, cw2, sg;
    prmt.b32 q0_4, LP, LN, sv;
    shr.b32 sh, sv, 16;
    prmt.b32 q0_5, LP, LN, sh;
    bfe.u32 s7, w0_15, 21, 7;
    shl.b32 t6, s7, 6;
    lop3.b32 x, s7, t6, K3333, 0xA8;   // (s7 | s7 << 6) & 0x3333
    popc.b32 pc, s7;
    bfi.b32 x, pc, x, 13, 1;          // the eighth sign: the parity of the seven
    prmt.b32 sg, LS, ZERO, x;
    bfe.u32 eo, w0_14, 24, 8;
    shl.b32 eo, eo, 5;
    add.u32 ea, tabl, eo;
    ld.shared.u32 cw2, [ea];
    or.b32 sv, cw2, sg;
    prmt.b32 q0_6, LP, LN, sv;
    shr.b32 sh, sv, 16;
    prmt.b32 q0_7, LP, LN, sh;
    shr.b32 t0, w0_15, 27;
    or.b32 t0, t0, 0x4B000001;
    mov.b32 fl0, t0;
    add.ftz.f32 fl0, fl0, 0fCB000000;  // 2 scale + 1
    mul.ftz.f32 nc0, fl0, 0fCB400000;  // -(2 scale + 1) * 1.5 * 2^23
    bfe.u32 s7, w1_15, 0, 7;
    shl.b32 t6, s7, 6;
    lop3.b32 x, s7, t6, K3333, 0xA8;   // (s7 | s7 << 6) & 0x3333
    popc.b32 pc, s7;
    bfi.b32 x, pc, x, 13, 1;          // the eighth sign: the parity of the seven
    prmt.b32 sg, LS, ZERO, x;
    bfe.u32 eo, w1_14, 0, 8;
    shl.b32 eo, eo, 5;
    add.u32 ea, tabl, eo;
    ld.shared.u32 cw2, [ea];
    or.b32 sv, cw2, sg;
    prmt.b32 q1_0, LP, LN, sv;
    shr.b32 sh, sv, 16;
    prmt.b32 q1_1, LP, LN, sh;
    bfe.u32 s7, w1_15, 7, 7;
    shl.b32 t6, s7, 6;
    lop3.b32 x, s7, t6, K3333, 0xA8;   // (s7 | s7 << 6) & 0x3333
    popc.b32 pc, s7;
    bfi.b32 x, pc, x, 13, 1;          // the eighth sign: the parity of the seven
    prmt.b32 sg, LS, ZERO, x;
    bfe.u32 eo, w1_14, 8, 8;
    shl.b32 eo, eo, 5;
    add.u32 ea, tabl, eo;
    ld.shared.u32 cw2, [ea];
    or.b32 sv, cw2, sg;
    prmt.b32 q1_2, LP, LN, sv;
    shr.b32 sh, sv, 16;
    prmt.b32 q1_3, LP, LN, sh;
    bfe.u32 s7, w1_15, 14, 7;
    shl.b32 t6, s7, 6;
    lop3.b32 x, s7, t6, K3333, 0xA8;   // (s7 | s7 << 6) & 0x3333
    popc.b32 pc, s7;
    bfi.b32 x, pc, x, 13, 1;          // the eighth sign: the parity of the seven
    prmt.b32 sg, LS, ZERO, x;
    bfe.u32 eo, w1_14, 16, 8;
    shl.b32 eo, eo, 5;
    add.u32 ea, tabl, eo;
    ld.shared.u32 cw2, [ea];
    or.b32 sv, cw2, sg;
    prmt.b32 q1_4, LP, LN, sv;
    shr.b32 sh, sv, 16;
    prmt.b32 q1_5, LP, LN, sh;
    bfe.u32 s7, w1_15, 21, 7;
    shl.b32 t6, s7, 6;
    lop3.b32 x, s7, t6, K3333, 0xA8;   // (s7 | s7 << 6) & 0x3333
    popc.b32 pc, s7;
    bfi.b32 x, pc, x, 13, 1;          // the eighth sign: the parity of the seven
    prmt.b32 sg, LS, ZERO, x;
    bfe.u32 eo, w1_14, 24, 8;
    shl.b32 eo, eo, 5;
    add.u32 ea, tabl, eo;
    ld.shared.u32 cw2, [ea];
    or.b32 sv, cw2, sg;
    prmt.b32 q1_6, LP, LN, sv;
    shr.b32 sh, sv, 16;
    prmt.b32 q1_7, LP, LN, sh;
    shr.b32 t0, w1_15, 27;
    or.b32 t0, t0, 0x4B000001;
    mov.b32 fl1, t0;
    add.ftz.f32 fl1, fl1, 0fCB000000;  // 2 scale + 1
    mul.ftz.f32 nc1, fl1, 0fCB400000;  // -(2 scale + 1) * 1.5 * 2^23
    ld.shared.v4.u32 {ua0, ua1, ua2, ua3}, [au+224];
    ld.shared.v4.u32 {ub0, ub1, ub2, ub3}, [au+240];
    ld.shared.f32 fa, [ad+28];
    dp4a.s32.s32 ia, q0_0, ua0, DBASE;
    dp4a.s32.s32 ia, q0_1, ua1, ia;
    dp4a.s32.s32 ia, q0_2, ua2, ia;
    dp4a.s32.s32 ia, q0_3, ua3, ia;
    dp4a.s32.s32 ia, q0_4, ub0, ia;
    dp4a.s32.s32 ia, q0_5, ub1, ia;
    dp4a.s32.s32 ia, q0_6, ub2, ia;
    dp4a.s32.s32 ia, q0_7, ub3, ia;
    mov.b32 fi, ia;
    fma.rn.ftz.f32 fp, fl0, fi, nc0;     // (float) (ls * isum), exactly
    fma.rn.ftz.f32 sf0_0, fa, fp, sf0_0;
    dp4a.s32.s32 ia, q1_0, ua0, DBASE;
    dp4a.s32.s32 ia, q1_1, ua1, ia;
    dp4a.s32.s32 ia, q1_2, ua2, ia;
    dp4a.s32.s32 ia, q1_3, ua3, ia;
    dp4a.s32.s32 ia, q1_4, ub0, ia;
    dp4a.s32.s32 ia, q1_5, ub1, ia;
    dp4a.s32.s32 ia, q1_6, ub2, ia;
    dp4a.s32.s32 ia, q1_7, ub3, ia;
    mov.b32 fi, ia;
    fma.rn.ftz.f32 fp, fl1, fi, nc1;     // (float) (ls * isum), exactly
    fma.rn.ftz.f32 sf0_1, fa, fp, sf0_1;
    // the super-block's d: lane 0's in the low half of dw, lane 1's in the high half
    shr.b32 t0, dw0, 16;
    selp.b32 dsh, t0, dw0, psl;
    mov.b32 {h0, h1}, dsh;
    cvt.f32.f16 fd, h0;
    mul.ftz.f32 fd, fd, 0f3E000000;
    fma.rn.ftz.f32 acc0_0, fd, sf0_0, acc0_0;
    shr.b32 t0, dw1, 16;
    selp.b32 dsh, t0, dw1, psl;
    mov.b32 {h0, h1}, dsh;
    cvt.f32.f16 fd, h0;
    mul.ftz.f32 fd, fd, 0f3E000000;
    fma.rn.ftz.f32 acc0_1, fd, sf0_1, acc0_1;
    add.u32 itr, itr, 1;
    setp.lt.u32 p0, itr, 5;
    @p0 bra.uni N1_ITER;
    // the row's two lanes summed, then up * SiLU(gate) (ggml_cuda_op_silu_single under -use_fast_math)
    mov.b32 rt0, acc0_0;
    shfl.sync.bfly.b32 rt1, rt0, 1, 31, -1;
    mov.b32 fs, rt1;
    add.ftz.f32 acc0_0, acc0_0, fs;
    mov.b32 rt0, acc0_1;
    shfl.sync.bfly.b32 rt1, rt0, 1, 31, -1;
    mov.b32 fs, rt1;
    add.ftz.f32 acc0_1, acc0_1, fs;
    setp.eq.u32 p0, sl, 0;
    setp.lt.u32 pst, row0, nrows;
    and.pred pst, pst, p0;
    mul.ftz.f32 fe, acc0_1, 0fBFB8AA3B;
    ex2.approx.ftz.f32 fe, fe;
    add.ftz.f32 fe, fe, 0f3F800000;
    div.approx.ftz.f32 fg, acc0_1, fe;
    mul.ftz.f32 fu, acc0_0, fg;
    add.u32 t0, dc0, row0;
    mul.wide.u32 o64, t0, 4;
    add.u64 a64, dstp, o64;
    @pst st.global.f32 [a64], fu;
    add.u32 rbi, rbi, 1;
    bra.uni N1_ROWBLOCK;

BODY2:
    // groups of 2 member(s): member j's output offset dc<j>
    shfl.sync.idx.b32 dc0, doff, 0, 31, -1;
    shfl.sync.idx.b32 dc1, doff, 1, 31, -1;
    mov.u32 rbi, 0;
N2_ROWBLOCK:
    setp.ge.u32 p0, rbi, rb;
    @p0 bra.uni DONE;
    add.u32 rblk, rbx, rbi;
    setp.ge.u32 p0, rblk, nrowblocks;
    @p0 bra.uni DONE;
    // rows 4 apart: warp w takes rows w, w + 4, ..., w + 60 of the row block; lane pair grp row w + 4 grp
    shl.b32 row0, rblk, 6;
    add.u32 row0, row0, warp;
    shl.b32 t0, grp, 2;
    add.u32 row0, row0, t0;
    add.u32 t0, nrows, -1;
    min.u32 rowc, row0, t0;
    mul.wide.u32 ro64, rowc, row_bytes;
    add.u64 rw0, xu, ro64;
    add.u64 rw1, xg, ro64;
    // kappa: the word of its first 16-byte unit at which the warp's segments start (lane 0's row)
    cvt.u32.u64 t0, rw0;
    bfe.u32 t0, t0, 2, 2;
    shfl.sync.idx.b32 kap0, t0, 0, 31, -1;
    mov.f32 acc0_0, 0f00000000;
    mov.f32 acc0_1, 0f00000000;
    mov.f32 acc1_0, 0f00000000;
    mov.f32 acc1_1, 0f00000000;
    mov.u32 itr, 0;
N2_ITER:
    // the lane's super-block c = 2 it + sl: its activations au (member 0) and scales ad
    shl.b32 cs, itr, 1;
    add.u32 cs, cs, sl;
    mad.lo.u32 au, cs, 272, act;
    shl.b32 t0, cs, 5;
    add.u32 ad, ad0, t0;
    mad.lo.u32 au1, act_tok, 1, au;
    mad.lo.u32 ad1, act_tok, 1, ad;
    // both matrices' segments: lane sl loads the 5 aligned 16-byte units from (segment & ~15) + 64 sl
    mul.lo.u32 sego, itr, 132;
    cvt.u64.u32 w64, sego;
    add.u64 seg, rw0, w64;
    and.b64 seg, seg, -16;
    add.u64 seg, seg, sl64;
    ld.global.nc.v4.u32 {u0_0, u0_1, u0_2, u0_3}, [seg+0];
    ld.global.nc.v4.u32 {u0_4, u0_5, u0_6, u0_7}, [seg+16];
    ld.global.nc.v4.u32 {u0_8, u0_9, u0_10, u0_11}, [seg+32];
    ld.global.nc.v4.u32 {u0_12, u0_13, u0_14, u0_15}, [seg+48];
    ld.global.nc.v4.u32 {u0_16, u0_17, u0_18, u0_19}, [seg+64];
    add.u64 seg, rw1, w64;
    and.b64 seg, seg, -16;
    add.u64 seg, seg, sl64;
    ld.global.nc.v4.u32 {u1_0, u1_1, u1_2, u1_3}, [seg+0];
    ld.global.nc.v4.u32 {u1_4, u1_5, u1_6, u1_7}, [seg+16];
    ld.global.nc.v4.u32 {u1_8, u1_9, u1_10, u1_11}, [seg+32];
    ld.global.nc.v4.u32 {u1_12, u1_13, u1_14, u1_15}, [seg+48];
    ld.global.nc.v4.u32 {u1_16, u1_17, u1_18, u1_19}, [seg+64];
    // the words of each super-block after its d, by kappa (warp-uniform): w<m>_k = bytes 2 + 4k .. 5 + 4k
    add.u32 kap, kap0, itr;
    and.b32 kap, kap, 3;
    setp.eq.u32 p0, kap, 0;
    @p0 bra.uni N2_KAPPA0;
    setp.eq.u32 p0, kap, 1;
    @p0 bra.uni N2_KAPPA1;
    setp.eq.u32 p0, kap, 2;
    @p0 bra.uni N2_KAPPA2;
    prmt.b32 w0_0, u0_3, u0_4, sel;
    prmt.b32 w0_1, u0_4, u0_5, sel;
    prmt.b32 w0_2, u0_5, u0_6, sel;
    prmt.b32 w0_3, u0_6, u0_7, sel;
    prmt.b32 w0_4, u0_7, u0_8, sel;
    prmt.b32 w0_5, u0_8, u0_9, sel;
    prmt.b32 w0_6, u0_9, u0_10, sel;
    prmt.b32 w0_7, u0_10, u0_11, sel;
    prmt.b32 w0_8, u0_11, u0_12, sel;
    prmt.b32 w0_9, u0_12, u0_13, sel;
    prmt.b32 w0_10, u0_13, u0_14, sel;
    prmt.b32 w0_11, u0_14, u0_15, sel;
    prmt.b32 w0_12, u0_15, u0_16, sel;
    prmt.b32 w0_13, u0_16, u0_17, sel;
    prmt.b32 w0_14, u0_17, u0_18, sel;
    prmt.b32 w0_15, u0_18, u0_19, sel;
    mov.b32 dw0, u0_3;
    prmt.b32 w1_0, u1_3, u1_4, sel;
    prmt.b32 w1_1, u1_4, u1_5, sel;
    prmt.b32 w1_2, u1_5, u1_6, sel;
    prmt.b32 w1_3, u1_6, u1_7, sel;
    prmt.b32 w1_4, u1_7, u1_8, sel;
    prmt.b32 w1_5, u1_8, u1_9, sel;
    prmt.b32 w1_6, u1_9, u1_10, sel;
    prmt.b32 w1_7, u1_10, u1_11, sel;
    prmt.b32 w1_8, u1_11, u1_12, sel;
    prmt.b32 w1_9, u1_12, u1_13, sel;
    prmt.b32 w1_10, u1_13, u1_14, sel;
    prmt.b32 w1_11, u1_14, u1_15, sel;
    prmt.b32 w1_12, u1_15, u1_16, sel;
    prmt.b32 w1_13, u1_16, u1_17, sel;
    prmt.b32 w1_14, u1_17, u1_18, sel;
    prmt.b32 w1_15, u1_18, u1_19, sel;
    mov.b32 dw1, u1_3;
    bra.uni N2_WORDS;
N2_KAPPA0:
    prmt.b32 w0_0, u0_0, u0_1, sel;
    prmt.b32 w0_1, u0_1, u0_2, sel;
    prmt.b32 w0_2, u0_2, u0_3, sel;
    prmt.b32 w0_3, u0_3, u0_4, sel;
    prmt.b32 w0_4, u0_4, u0_5, sel;
    prmt.b32 w0_5, u0_5, u0_6, sel;
    prmt.b32 w0_6, u0_6, u0_7, sel;
    prmt.b32 w0_7, u0_7, u0_8, sel;
    prmt.b32 w0_8, u0_8, u0_9, sel;
