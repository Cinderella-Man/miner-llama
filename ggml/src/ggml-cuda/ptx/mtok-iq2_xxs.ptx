    prmt.b32 w1_12, u1_14, u1_15, sel;
    prmt.b32 w1_13, u1_15, u1_16, sel;
    prmt.b32 w1_14, u1_16, u1_17, sel;
    prmt.b32 w1_15, u1_17, u1_18, sel;
    mov.b32 dw1, u1_2;
N6_WORDS:
    mov.f32 sf0_0, 0f00000000;
    mov.f32 sf0_1, 0f00000000;
    mov.f32 sf1_0, 0f00000000;
    mov.f32 sf1_1, 0f00000000;
    mov.f32 sf2_0, 0f00000000;
    mov.f32 sf2_1, 0f00000000;
    mov.f32 sf3_0, 0f00000000;
    mov.f32 sf3_1, 0f00000000;
    mov.f32 sf4_0, 0f00000000;
    mov.f32 sf4_1, 0f00000000;
    mov.f32 sf5_0, 0f00000000;
    mov.f32 sf5_1, 0f00000000;
    // block 0: weights 0..31
    bfe.u32 s7, w0_1, 0, 7;
    shl.b32 t6, s7, 6;
    lop3.b32 x, s7, t6, K3333, 0xA8;   // (s7 | s7 << 6) & 0x3333
    popc.b32 pc, s7;
    bfi.b32 x, pc, x, 13, 1;          // the eighth sign: the parity of the seven
    prmt.b32 sg, LS, ZERO, x;
    bfe.u32 eo, w0_0, 0, 8;
    shl.b32 eo, eo, 5;
    add.u32 ea, tabl, eo;
    ld.shared.u32 cw2, [ea];
    or.b32 sv, cw2, sg;
    prmt.b32 q0_0, LP, LN, sv;
    shr.b32 sh, sv, 16;
    prmt.b32 q0_1, LP, LN, sh;
    bfe.u32 s7, w0_1, 7, 7;
    shl.b32 t6, s7, 6;
    lop3.b32 x, s7, t6, K3333, 0xA8;   // (s7 | s7 << 6) & 0x3333
    popc.b32 pc, s7;
    bfi.b32 x, pc, x, 13, 1;          // the eighth sign: the parity of the seven
    prmt.b32 sg, LS, ZERO, x;
    bfe.u32 eo, w0_0, 8, 8;
    shl.b32 eo, eo, 5;
    add.u32 ea, tabl, eo;
    ld.shared.u32 cw2, [ea];
    or.b32 sv, cw2, sg;
    prmt.b32 q0_2, LP, LN, sv;
    shr.b32 sh, sv, 16;
    prmt.b32 q0_3, LP, LN, sh;
    bfe.u32 s7, w0_1, 14, 7;
    shl.b32 t6, s7, 6;
    lop3.b32 x, s7, t6, K3333, 0xA8;   // (s7 | s7 << 6) & 0x3333
    popc.b32 pc, s7;
