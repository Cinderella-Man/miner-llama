    shl.b32 t6, s7, 6;
    lop3.b32 x, s7, t6, K3333, 0xA8;   // (s7 | s7 << 6) & 0x3333
    popc.b32 pc, s7;
    bfi.b32 x, pc, x, 13, 1;          // the eighth sign: the parity of the seven
    prmt.b32 sg, LS, ZERO, x;
    bfe.u32 eo, w1_0, 0, 8;
    shl.b32 eo, eo, 5;
    add.u32 ea, tabl, eo;
    ld.shared.u32 cw2, [ea];
    or.b32 sv, cw2, sg;
    prmt.b32 q1_0, LP, LN, sv;
    shr.b32 sh, sv, 16;
    prmt.b32 q1_1, LP, LN, sh;
    bfe.u32 s7, w1_1, 7, 7;
    shl.b32 t6, s7, 6;
    lop3.b32 x, s7, t6, K3333, 0xA8;   // (s7 | s7 << 6) & 0x3333
    popc.b32 pc, s7;
    bfi.b32 x, pc, x, 13, 1;          // the eighth sign: the parity of the seven
    prmt.b32 sg, LS, ZERO, x;
    bfe.u32 eo, w1_0, 8, 8;
    shl.b32 eo, eo, 5;
    add.u32 ea, tabl, eo;
    ld.shared.u32 cw2, [ea];
    or.b32 sv, cw2, sg;
    prmt.b32 q1_2, LP, LN, sv;
    shr.b32 sh, sv, 16;
