N7_KAPPA2:
    prmt.b32 w0_0, u0_2, u0_3, sel;
    prmt.b32 w0_1, u0_3, u0_4, sel;
    prmt.b32 w0_2, u0_4, u0_5, sel;
    prmt.b32 w0_3, u0_5, u0_6, sel;
    prmt.b32 w0_4, u0_6, u0_7, sel;
    prmt.b32 w0_5, u0_7, u0_8, sel;
    prmt.b32 w0_6, u0_8, u0_9, sel;
    prmt.b32 w0_7, u0_9, u0_10, sel;
    prmt.b32 w0_8, u0_10, u0_11, sel;
    prmt.b32 w0_9, u0_11, u0_12, sel;
    prmt.b32 w0_10, u0_12, u0_13, sel;
