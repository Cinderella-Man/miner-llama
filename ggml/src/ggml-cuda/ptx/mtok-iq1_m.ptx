.visible .entry mtok_iq1m_fast_ptx_ntm2(
    .param .align 8 .b8 P[168],
    .param .align 8 .b8 F[80]
)
.maxntid 128, 1, 1
.minnctapersm 3
{
    .reg .pred p0, p1, p2, p3, p4, pq, pst;
    .reg .b16 h0, h1;
    .reg .b32 lane, warp, bx, by, bz, tid, nrows, row_bytes, nrowblocks, rb, gcap, ncols;
    .reg .b32 nslots, ids_stride, act_tok, ncy_x, ncy_y, ncy_z, sr_x, sr_y, t0, t1, t2, t3;
    .reg .b32 sx, ne, ty, ky, ey, idx, rank, i, v, bal, cnt, mk0;
    .reg .b32 mk1, mk2, mk3, total, hsel, rr, msk, nt, yoff, doff, bit, kk;
    .reg .b32 chy, tabb, sa, gw0, gw1, gw2, gw3, gw4, gw5, gw6, gw7, gw8;
    .reg .b32 gw9, gw10, gw11, gw12, gw13, gw14, gw15, act, jm, yj, aj, drel;
    .reg .b32 srel, pa0, pa1, pa2, pa3, y0, y1, y2, y3, y4, y5, y6;
    .reg .b32 y7, y8, sl, grp, ad0, rbx, LP, LN, ZERO, DBASE, KS0, KS1;
    .reg .b32 K01, KF0, dc0, rbi, rblk, row0, rowc, itr, cs, au, ad, sego;
    .reg .b32 w0_0, w0_1, w0_2, w0_3, w0_4, w0_5, w0_6, w0_7, w0_8, w0_9, w0_10, w0_11;
    .reg .b32 w0_12, w0_13, w1_0, w1_1, w1_2, w1_3, w1_4, w1_5, w1_6, w1_7, w1_8, w1_9;
    .reg .b32 w1_10, w1_11, w1_12, w1_13, px, ea, cw, sh, ia, ib1, ts, tz;
    .reg .b32 qh4_0, qh4_1, q0_0, q0_1, q0_2, q0_3, q0_4, q0_5, q0_6, q0_7, q1_0, q1_1;
    .reg .b32 q1_2, q1_3, q1_4, q1_5, q1_6, q1_7, ua0, ua1, ua2, ua3, ub0, ub1;
    .reg .b32 ub2, ub3, e0_0, e0_1, e1_0, e1_1, dsh, rt0, rt1, dc1, au1, ad1;
    .reg .b64 vx, vy, ids, dstp, gatep, chbx, smbx, chby, smby, colby, scd, ssd;
    .reg .b64 scold, a64, o64, w64, x64, cods, xo, xu, xg, sl64, rw0, rw1;
    .reg .b64 ro64, seg, dsk;
    .reg .f32 fsc, acc0_0, acc0_1, sf0_0, sf0_1, fl0_0, fl0_1, fl1_0, fl1_1, nc1_0, nc1_1, fa;
    .reg .f32 fi, fp, fr, fd, fs, fu, fg, fe, acc1_0, acc1_1, sf1_0, sf1_1;
    .shared .align 16 .b32 tab[4096];

    // thread, block and parameters
    mov.u32 lane, %tid.x;
    mov.u32 warp, %tid.y;
    mov.u32 bx, %ctaid.x;
    mov.u32 by, %ctaid.y;
    mov.u32 bz, %ctaid.z;
    mad.lo.u32 tid, warp, 32, lane;
    ld.param.u64 vx, [P+0];
    cvta.to.global.u64 vx, vx;
    ld.param.u64 vy, [P+8];
    cvta.to.global.u64 vy, vy;
    ld.param.u64 ids, [P+16];
    cvta.to.global.u64 ids, ids;
    ld.param.u64 dstp, [P+24];
    cvta.to.global.u64 dstp, dstp;
    ld.param.u64 gatep, [F+8];
    cvta.to.global.u64 gatep, gatep;
    ld.param.u32 nrows, [P+32];
    ld.param.u32 row_bytes, [P+36];
    ld.param.u32 nrowblocks, [P+48];
    ld.param.u32 rb, [P+52];
    ld.param.u32 gcap, [P+56];
    ld.param.u32 ncols, [P+60];
    ld.param.u32 nslots, [P+64];
    ld.param.u32 ids_stride, [P+68];
    ld.param.u32 act_tok, [P+76];
    ld.param.u32 ncy_x, [P+80];
    ld.param.u32 ncy_y, [P+84];
    ld.param.u32 ncy_z, [P+88];
    ld.param.u32 sr_x, [P+92];
    ld.param.u32 sr_y, [P+96];
    ld.param.u64 chbx, [P+104];
    ld.param.u64 smbx, [P+112];
    ld.param.u64 chby, [P+120];
    ld.param.u64 smby, [P+128];
    ld.param.u64 colby, [P+136];
    ld.param.u64 scd, [P+144];
    ld.param.u64 ssd, [P+152];
    ld.param.u64 scold, [P+160];
    // sample_x = fastdiv(blockIdx.z, sample_ratio)
    mul.hi.u32 t0, bz, sr_x;
    add.u32 t0, t0, bz;
    shr.b32 sx, t0, sr_y;

    // the block's group (mtok_iq::group): entry blockIdx.y = token ty, slot ky; its expert ey
    mul.lo.u32 ne, ncols, nslots;
    div.u32 ty, by, nslots;
    mul.lo.u32 t0, ty, nslots;
    sub.u32 ky, by, t0;
    mad.lo.u32 idx, ty, ids_stride, ky;
    mul.wide.u32 o64, idx, 4;
    add.u64 a64, ids, o64;
    ld.global.s32 ey, [a64];
    setp.lt.s32 p0, ey, 0;
    @p0 bra.uni SKIPPED;
    // rank: the entries before this one with the same expert; mk<h>: those from it on, 32 entries a word
    mov.u32 rank, 0;
    add.u32 i, lane, 0;
    div.u32 t0, i, nslots;
    mul.lo.u32 t1, t0, nslots;
    sub.u32 t1, i, t1;
    mad.lo.u32 idx, t0, ids_stride, t1;
    mul.wide.u32 o64, idx, 4;
    add.u64 a64, ids, o64;
    setp.lt.u32 p1, i, ne;
    mov.u32 v, -1;
    @p1 ld.global.s32 v, [a64];
    setp.eq.s32 p2, v, ey;
    setp.lt.u32 p3, i, by;
    and.pred p4, p2, p3;
    vote.sync.ballot.b32 bal, p4, -1;
    popc.b32 cnt, bal;
    add.u32 rank, rank, cnt;
    setp.ge.u32 p3, i, by;
    and.pred p4, p2, p3;
    vote.sync.ballot.b32 mk0, p4, -1;
    add.u32 i, lane, 32;
    div.u32 t0, i, nslots;
    mul.lo.u32 t1, t0, nslots;
    sub.u32 t1, i, t1;
    mad.lo.u32 idx, t0, ids_stride, t1;
    mul.wide.u32 o64, idx, 4;
    add.u64 a64, ids, o64;
    setp.lt.u32 p1, i, ne;
    mov.u32 v, -1;
    @p1 ld.global.s32 v, [a64];
    setp.eq.s32 p2, v, ey;
    setp.lt.u32 p3, i, by;
    and.pred p4, p2, p3;
    vote.sync.ballot.b32 bal, p4, -1;
    popc.b32 cnt, bal;
    add.u32 rank, rank, cnt;
    setp.ge.u32 p3, i, by;
    and.pred p4, p2, p3;
    vote.sync.ballot.b32 mk1, p4, -1;
    add.u32 i, lane, 64;
    div.u32 t0, i, nslots;
    mul.lo.u32 t1, t0, nslots;
    sub.u32 t1, i, t1;
    mad.lo.u32 idx, t0, ids_stride, t1;
    mul.wide.u32 o64, idx, 4;
    add.u64 a64, ids, o64;
    setp.lt.u32 p1, i, ne;
    mov.u32 v, -1;
    @p1 ld.global.s32 v, [a64];
    setp.eq.s32 p2, v, ey;
    setp.lt.u32 p3, i, by;
    and.pred p4, p2, p3;
    vote.sync.ballot.b32 bal, p4, -1;
    popc.b32 cnt, bal;
    add.u32 rank, rank, cnt;
    setp.ge.u32 p3, i, by;
    and.pred p4, p2, p3;
    vote.sync.ballot.b32 mk2, p4, -1;
    add.u32 i, lane, 96;
    div.u32 t0, i, nslots;
    mul.lo.u32 t1, t0, nslots;
    sub.u32 t1, i, t1;
    mad.lo.u32 idx, t0, ids_stride, t1;
    mul.wide.u32 o64, idx, 4;
    add.u64 a64, ids, o64;
    setp.lt.u32 p1, i, ne;
    mov.u32 v, -1;
    @p1 ld.global.s32 v, [a64];
    setp.eq.s32 p2, v, ey;
    setp.lt.u32 p3, i, by;
    and.pred p4, p2, p3;
    vote.sync.ballot.b32 bal, p4, -1;
    popc.b32 cnt, bal;
    add.u32 rank, rank, cnt;
    setp.ge.u32 p3, i, by;
    and.pred p4, p2, p3;
    vote.sync.ballot.b32 mk3, p4, -1;
    rem.u32 t0, rank, gcap;
    setp.ne.u32 p0, t0, 0;
    @p0 bra.uni DONE;
    // lane j < nt finds the group's member j: the j-th set bit of mk0..mk3
    mov.u32 total, 0;
    mov.u32 hsel, 4;
    mov.u32 rr, 0;
    mov.u32 msk, 0;
    popc.b32 cnt, mk0;
    add.u32 t0, total, cnt;
    setp.eq.u32 p1, hsel, 4;
    setp.lt.u32 p2, lane, t0;
    and.pred p3, p1, p2;
    @p3 mov.u32 hsel, 0;
    @p3 sub.u32 rr, lane, total;
    @p3 mov.u32 msk, mk0;
    mov.u32 total, t0;
    popc.b32 cnt, mk1;
    add.u32 t0, total, cnt;
    setp.eq.u32 p1, hsel, 4;
    setp.lt.u32 p2, lane, t0;
    and.pred p3, p1, p2;
    @p3 mov.u32 hsel, 1;
    @p3 sub.u32 rr, lane, total;
    @p3 mov.u32 msk, mk1;
    mov.u32 total, t0;
    popc.b32 cnt, mk2;
    add.u32 t0, total, cnt;
    setp.eq.u32 p1, hsel, 4;
    setp.lt.u32 p2, lane, t0;
    and.pred p3, p1, p2;
    @p3 mov.u32 hsel, 2;
    @p3 sub.u32 rr, lane, total;
    @p3 mov.u32 msk, mk2;
    mov.u32 total, t0;
    popc.b32 cnt, mk3;
    add.u32 t0, total, cnt;
    setp.eq.u32 p1, hsel, 4;
    setp.lt.u32 p2, lane, t0;
    and.pred p3, p1, p2;
    @p3 mov.u32 hsel, 3;
    @p3 sub.u32 rr, lane, total;
    @p3 mov.u32 msk, mk3;
    mov.u32 total, t0;
    min.u32 nt, gcap, total;
    mov.u32 yoff, 0;
    mov.u32 doff, 0;
    setp.ge.u32 p1, lane, nt;
    @p1 bra MEMBER_DONE;
DROP_BITS:
    setp.eq.u32 p2, rr, 0;
    @p2 bra DROPPED;
    add.u32 t0, msk, -1;
    and.b32 msk, msk, t0;
    sub.u32 rr, rr, 1;
    bra DROP_BITS;
DROPPED:
    neg.s32 t0, msk;
    and.b32 t0, msk, t0;
    bfind.u32 bit, t0;
    shl.b32 i, hsel, 5;
    add.u32 i, i, bit;
    div.u32 t0, i, nslots;
    mul.lo.u32 t1, t0, nslots;
    sub.u32 kk, i, t1;
    // channel_y = fastmodulo(k, nchannels_y)
    mul.hi.u32 t2, kk, ncy_x;
    add.u32 t2, t2, kk;
    shr.b32 t2, t2, ncy_y;
    mul.lo.u32 t2, t2, ncy_z;
    sub.u32 chy, kk, t2;
    // yoff = sample * sample_bytes_y + channel_y * channel_bytes_y + token * col_bytes_y (fits an int)
    cvt.u64.u32 w64, bz;
    mul.lo.u64 x64, w64, smby;
    cvt.u64.u32 w64, chy;
    mad.lo.u64 x64, w64, chby, x64;
    cvt.u64.u32 w64, t0;
    mad.lo.u64 x64, w64, colby, x64;
    cvt.u32.u64 yoff, x64;
    // doff = sample * stride_sample_dst + slot * stride_channel_dst + token * stride_col_dst
    cvt.u64.u32 w64, bz;
    mul.lo.u64 x64, w64, ssd;
    cvt.u64.u32 w64, kk;
    mad.lo.u64 x64, w64, scd, x64;
    cvt.u64.u32 w64, t0;
    mad.lo.u64 x64, w64, scold, x64;
    cvt.u32.u64 doff, x64;
MEMBER_DONE:

    // the code table: the grid's 2,048 entries (grid + 1 as nibbles), then the same with bit 2 of every nibble set (a negative delta): the 11-bit grid index and the delta's sign above it address it
    mov.u32 tabb, tab;
    mov.u64 cods, mtok_iq1m_grid;
    mul.wide.u32 o64, tid, 16;
    add.u64 a64, cods, o64;
    ld.global.nc.v4.u32 {gw0, gw1, gw2, gw3}, [a64+0];
    ld.global.nc.v4.u32 {gw4, gw5, gw6, gw7}, [a64+2048];
    ld.global.nc.v4.u32 {gw8, gw9, gw10, gw11}, [a64+4096];
    ld.global.nc.v4.u32 {gw12, gw13, gw14, gw15}, [a64+6144];
    shl.b32 sa, tid, 4;
    add.u32 sa, sa, tabb;
    st.shared.v4.u32 [sa+0], {gw0, gw1, gw2, gw3};
    st.shared.v4.u32 [sa+2048], {gw4, gw5, gw6, gw7};
    st.shared.v4.u32 [sa+4096], {gw8, gw9, gw10, gw11};
    st.shared.v4.u32 [sa+6144], {gw12, gw13, gw14, gw15};
    or.b32 gw0, gw0, 0x44444444;
    or.b32 gw1, gw1, 0x44444444;
    or.b32 gw2, gw2, 0x44444444;
    or.b32 gw3, gw3, 0x44444444;
    or.b32 gw4, gw4, 0x44444444;
    or.b32 gw5, gw5, 0x44444444;
    or.b32 gw6, gw6, 0x44444444;
    or.b32 gw7, gw7, 0x44444444;
    or.b32 gw8, gw8, 0x44444444;
    or.b32 gw9, gw9, 0x44444444;
    or.b32 gw10, gw10, 0x44444444;
    or.b32 gw11, gw11, 0x44444444;
    or.b32 gw12, gw12, 0x44444444;
    or.b32 gw13, gw13, 0x44444444;
    or.b32 gw14, gw14, 0x44444444;
    or.b32 gw15, gw15, 0x44444444;
    st.shared.v4.u32 [sa+8192], {gw0, gw1, gw2, gw3};
    st.shared.v4.u32 [sa+10240], {gw4, gw5, gw6, gw7};
    st.shared.v4.u32 [sa+12288], {gw8, gw9, gw10, gw11};
    st.shared.v4.u32 [sa+14336], {gw12, gw13, gw14, gw15};
    // the members' activations: each group of 8 int8 values as (0, 4, 1, 5), (2, 6, 3, 7); thread q < 80 stages
    // Q8_1 block q of each member: 256 values and 16 bytes of padding per super-block, the FP32 scales after them
    mov.u32 act, mtok_iq1m_dyn;
    setp.lt.u32 pq, tid, 80;
    shr.b32 t0, tid, 3;
    and.b32 t1, tid, 7;
    shl.b32 t1, t1, 5;
    mad.lo.u32 drel, t0, 272, t1;
    shl.b32 srel, tid, 2;
    add.u32 srel, srel, 2720;
    mul.wide.u32 w64, tid, 36;
    mov.u32 jm, 0;
STAGE_MEMBER:
    setp.ge.u32 p0, jm, nt;
    @p0 bra.uni STAGED;
    shfl.sync.idx.b32 yj, yoff, jm, 31, -1;
    mad.lo.u32 aj, jm, act_tok, act;
    cvt.s64.s32 x64, yj;
    add.u64 a64, vy, x64;
    add.u64 a64, a64, w64;
    @pq ld.global.nc.u32 y0, [a64+0];
    @pq ld.global.nc.u32 y1, [a64+4];
    @pq ld.global.nc.u32 y2, [a64+8];
    @pq ld.global.nc.u32 y3, [a64+12];
    @pq ld.global.nc.u32 y4, [a64+16];
    @pq ld.global.nc.u32 y5, [a64+20];
    @pq ld.global.nc.u32 y6, [a64+24];
    @pq ld.global.nc.u32 y7, [a64+28];
    @pq ld.global.nc.u32 y8, [a64+32];
    add.u32 sa, aj, drel;
    prmt.b32 pa0, y1, y2, 0x5140;
    prmt.b32 pa1, y1, y2, 0x7362;
    prmt.b32 pa2, y3, y4, 0x5140;
    prmt.b32 pa3, y3, y4, 0x7362;
    @pq st.shared.v4.u32 [sa], {pa0, pa1, pa2, pa3};
    prmt.b32 pa0, y5, y6, 0x5140;
    prmt.b32 pa1, y5, y6, 0x7362;
    prmt.b32 pa2, y7, y8, 0x5140;
    prmt.b32 pa3, y7, y8, 0x7362;
    @pq st.shared.v4.u32 [sa+16], {pa0, pa1, pa2, pa3};
    mov.b32 {h0, h1}, y0;
    cvt.f32.f16 fsc, h0;
    add.u32 sa, aj, srel;
    @pq st.shared.f32 [sa], fsc;
    add.u32 jm, jm, 1;
    bra.uni STAGE_MEMBER;
STAGED:
    bar.sync 0;

    // the expert's up and gate matrices; constants
    cvt.u64.u32 w64, sx;
    mul.lo.u64 xo, w64, smbx;
    cvt.u64.u32 w64, ey;
    mad.lo.u64 xo, w64, chbx, xo;
    add.u64 xu, vx, xo;
    add.u64 xg, gatep, xo;
    and.b32 sl, lane, 1;
    shr.b32 grp, lane, 1;
    add.u32 ad0, act, 2720;
    mul.lo.u32 rbx, bx, rb;
    mul.wide.u32 sl64, sl, 56;
    mov.b32 LP, 0x000901F9;    // bytes -7, 1, 9, 0: 8 (grid + 1/8) by code grid + 1
    mov.b32 LN, 0x0007FFF7;    // -9, -1, 7, 0: 8 (grid - 1/8)
    mov.b32 ZERO, 0;
    mov.b32 DBASE, 0x4B400000; // the float 1.5 * 2^23: a DP4A chain started there is that float + its sum
    mov.b32 KS0, 0x000E000E;   // 2 s of the scales at bits 0-2 of each 16-bit scale word, after a shift
    mov.b32 KS1, 0x0E000E00;   // 2 s of the scales at bits 6-8 (and 9-11)
    mov.b32 K01, 0x01010101;
    mov.b32 KF0, 0xF0F0F0F0;   // the high nibbles of every byte

    setp.eq.u32 p0, nt, 1;
    @p0 bra.uni BODY1;
    bra.uni BODY2;

BODY1:
    // groups of 1 member(s): member j's output offset dc<j>
    shfl.sync.idx.b32 dc0, doff, 0, 31, -1;
    mov.u32 rbi, 0;
N1_ROWBLOCK:
    setp.ge.u32 p0, rbi, rb;
    @p0 bra.uni DONE;
    add.u32 rblk, rbx, rbi;
    setp.ge.u32 p0, rblk, nrowblocks;
    @p0 bra.uni DONE;
    // rows 4 apart: warp w takes rows w, w + 4, ..., w + 60 of the row block; lane pair grp row w + 4 grp
    shl.b32 row0, rblk, 6;
    add.u32 row0, row0, warp;
    shl.b32 t0, grp, 2;
    add.u32 row0, row0, t0;
    add.u32 t0, nrows, -1;
    min.u32 rowc, row0, t0;
    mul.wide.u32 ro64, rowc, row_bytes;
    add.u64 rw0, xu, ro64;
    add.u64 rw1, xg, ro64;
    mov.f32 acc0_0, 0f00000000;
    mov.f32 acc0_1, 0f00000000;
    mov.u32 itr, 0;
N1_ITER:
    // the lane's super-block c = 2 it + sl: its activations au (member 0) and scales ad
    shl.b32 cs, itr, 1;
    add.u32 cs, cs, sl;
    mad.lo.u32 au, cs, 272, act;
    shl.b32 t0, cs, 5;
    add.u32 ad, ad0, t0;
    // both matrices' super-blocks: lane sl loads its 7 aligned 8-byte units from segment + 56 sl, w<m>_k = bytes 4k .. 4k + 3
    mul.lo.u32 sego, itr, 112;
    cvt.u64.u32 w64, sego;
    add.u64 seg, rw0, w64;
    add.u64 seg, seg, sl64;
    ld.global.nc.v2.u32 {w0_0, w0_1}, [seg+0];
    ld.global.nc.v2.u32 {w0_2, w0_3}, [seg+8];
    ld.global.nc.v2.u32 {w0_4, w0_5}, [seg+16];
    ld.global.nc.v2.u32 {w0_6, w0_7}, [seg+24];
    ld.global.nc.v2.u32 {w0_8, w0_9}, [seg+32];
    ld.global.nc.v2.u32 {w0_10, w0_11}, [seg+40];
    ld.global.nc.v2.u32 {w0_12, w0_13}, [seg+48];
    add.u64 seg, rw1, w64;
    add.u64 seg, seg, sl64;
    ld.global.nc.v2.u32 {w1_0, w1_1}, [seg+0];
    ld.global.nc.v2.u32 {w1_2, w1_3}, [seg+8];
    ld.global.nc.v2.u32 {w1_4, w1_5}, [seg+16];
    ld.global.nc.v2.u32 {w1_6, w1_7}, [seg+24];
    ld.global.nc.v2.u32 {w1_8, w1_9}, [seg+32];
    ld.global.nc.v2.u32 {w1_10, w1_11}, [seg+40];
    ld.global.nc.v2.u32 {w1_12, w1_13}, [seg+48];
    mov.f32 sf0_0, 0f00000000;
    mov.f32 sf0_1, 0f00000000;
    // blocks 0..3: the scales as bytes 2 s + 1
    shl.b32 ts, w0_12, 1;
    lop3.b32 tz, ts, KS0, K01, 0xEA;        // ((sw << 1) & 0x000E000E) | 0x01010101: 2 ls0 + 1, blocks 4h, 4h + 2
    shl.b32 ts, w0_12, 3;
    lop3.b32 e0_0, ts, KS1, tz, 0xEA;       // | ((sw << 3) & 0x0E000E00): blocks 4h + 1, 4h + 3
    shr.b32 ts, w0_12, 2;
    lop3.b32 tz, ts, KS0, K01, 0xEA;        // ((sw >> 2) & 0x000E000E) | 0x01010101: 2 ls1 + 1, blocks 4h, 4h + 2
    lop3.b32 e1_0, w0_12, KS1, tz, 0xEA;    // | (sw & 0x0E000E00): blocks 4h + 1, 4h + 3
    shl.b32 ts, w1_12, 1;
    lop3.b32 tz, ts, KS0, K01, 0xEA;        // ((sw << 1) & 0x000E000E) | 0x01010101: 2 ls0 + 1, blocks 4h, 4h + 2
    shl.b32 ts, w1_12, 3;
    lop3.b32 e0_1, ts, KS1, tz, 0xEA;       // | ((sw << 3) & 0x0E000E00): blocks 4h + 1, 4h + 3
    shr.b32 ts, w1_12, 2;
    lop3.b32 tz, ts, KS0, K01, 0xEA;        // ((sw >> 2) & 0x000E000E) | 0x01010101: 2 ls1 + 1, blocks 4h, 4h + 2
    lop3.b32 e1_1, w1_12, KS1, tz, 0xEA;    // | (sw & 0x0E000E00): blocks 4h + 1, 4h + 3
    // block 0: weights 0..31
    shr.b32 qh4_0, w0_8, 4;            // the qh nibbles of odd groups as low nibbles
    prmt.b32 px, w0_0, w0_8, 0x0040;  // group 0: the qs byte, the qh nibble above it
    bfi.b32 ea, px, ZERO, 2, 12;      // the 11-bit grid index and the delta's sign: the entry's word
    add.u32 ea, ea, tabb;
    ld.shared.u32 cw, [ea];
    prmt.b32 q0_0, LP, LN, cw;      // weights 0, 4, 1, 5: 8 (grid + delta)
    shr.b32 sh, cw, 16;
    prmt.b32 q0_1, LP, LN, sh;      // weights 2, 6, 3, 7
    prmt.b32 px, w0_0, qh4_0, 0x0041;  // group 1: the qs byte, the qh nibble above it
    bfi.b32 ea, px, ZERO, 2, 12;      // the 11-bit grid index and the delta's sign: the entry's word
    add.u32 ea, ea, tabb;
    ld.shared.u32 cw, [ea];
    prmt.b32 q0_2, LP, LN, cw;      // weights 0, 4, 1, 5: 8 (grid + delta)
    shr.b32 sh, cw, 16;
    prmt.b32 q0_3, LP, LN, sh;      // weights 2, 6, 3, 7
    prmt.b32 px, w0_0, w0_8, 0x0052;  // group 2: the qs byte, the qh nibble above it
    bfi.b32 ea, px, ZERO, 2, 12;      // the 11-bit grid index and the delta's sign: the entry's word
    add.u32 ea, ea, tabb;
    ld.shared.u32 cw, [ea];
    prmt.b32 q0_4, LP, LN, cw;      // weights 0, 4, 1, 5: 8 (grid + delta)
    shr.b32 sh, cw, 16;
    prmt.b32 q0_5, LP, LN, sh;      // weights 2, 6, 3, 7
    prmt.b32 px, w0_0, qh4_0, 0x0053;  // group 3: the qs byte, the qh nibble above it
    bfi.b32 ea, px, ZERO, 2, 12;      // the 11-bit grid index and the delta's sign: the entry's word
    add.u32 ea, ea, tabb;
    ld.shared.u32 cw, [ea];
    prmt.b32 q0_6, LP, LN, cw;      // weights 0, 4, 1, 5: 8 (grid + delta)
    shr.b32 sh, cw, 16;
    prmt.b32 q0_7, LP, LN, sh;      // weights 2, 6, 3, 7
    bfe.u32 ts, e0_0, 0, 8;
    cvt.rn.f32.u32 fl0_0, ts;           // 2 ls0 + 1
    bfe.u32 ts, e1_0, 0, 8;
    cvt.rn.f32.u32 fl1_0, ts;           // 2 ls1 + 1
    mul.ftz.f32 nc1_0, fl1_0, 0fCB400000;  // -(2 ls1 + 1) * 1.5 * 2^23
    shr.b32 qh4_1, w1_8, 4;            // the qh nibbles of odd groups as low nibbles
    prmt.b32 px, w1_0, w1_8, 0x0040;  // group 0: the qs byte, the qh nibble above it
    bfi.b32 ea, px, ZERO, 2, 12;      // the 11-bit grid index and the delta's sign: the entry's word
    add.u32 ea, ea, tabb;
    ld.shared.u32 cw, [ea];
    prmt.b32 q1_0, LP, LN, cw;      // weights 0, 4, 1, 5: 8 (grid + delta)
    shr.b32 sh, cw, 16;
    prmt.b32 q1_1, LP, LN, sh;      // weights 2, 6, 3, 7
    prmt.b32 px, w1_0, qh4_1, 0x0041;  // group 1: the qs byte, the qh nibble above it
    bfi.b32 ea, px, ZERO, 2, 12;      // the 11-bit grid index and the delta's sign: the entry's word
    add.u32 ea, ea, tabb;
    ld.shared.u32 cw, [ea];
    prmt.b32 q1_2, LP, LN, cw;      // weights 0, 4, 1, 5: 8 (grid + delta)
    shr.b32 sh, cw, 16;
    prmt.b32 q1_3, LP, LN, sh;      // weights 2, 6, 3, 7
    prmt.b32 px, w1_0, w1_8, 0x0052;  // group 2: the qs byte, the qh nibble above it
    bfi.b32 ea, px, ZERO, 2, 12;      // the 11-bit grid index and the delta's sign: the entry's word
    add.u32 ea, ea, tabb;
    ld.shared.u32 cw, [ea];
    prmt.b32 q1_4, LP, LN, cw;      // weights 0, 4, 1, 5: 8 (grid + delta)
    shr.b32 sh, cw, 16;
    prmt.b32 q1_5, LP, LN, sh;      // weights 2, 6, 3, 7
    prmt.b32 px, w1_0, qh4_1, 0x0053;  // group 3: the qs byte, the qh nibble above it
    bfi.b32 ea, px, ZERO, 2, 12;      // the 11-bit grid index and the delta's sign: the entry's word
    add.u32 ea, ea, tabb;
    ld.shared.u32 cw, [ea];
    prmt.b32 q1_6, LP, LN, cw;      // weights 0, 4, 1, 5: 8 (grid + delta)
    shr.b32 sh, cw, 16;
    prmt.b32 q1_7, LP, LN, sh;      // weights 2, 6, 3, 7
    bfe.u32 ts, e0_1, 0, 8;
    cvt.rn.f32.u32 fl0_1, ts;           // 2 ls0 + 1
    bfe.u32 ts, e1_1, 0, 8;
    cvt.rn.f32.u32 fl1_1, ts;           // 2 ls1 + 1
    mul.ftz.f32 nc1_1, fl1_1, 0fCB400000;  // -(2 ls1 + 1) * 1.5 * 2^23
    ld.shared.v4.u32 {ua0, ua1, ua2, ua3}, [au+0];
    ld.shared.v4.u32 {ub0, ub1, ub2, ub3}, [au+16];
    ld.shared.f32 fa, [ad+0];
    dp4a.s32.s32 ia, q0_0, ua0, DBASE;
    dp4a.s32.s32 ia, q0_1, ua1, ia;
    dp4a.s32.s32 ia, q0_2, ua2, ia;
    dp4a.s32.s32 ia, q0_3, ua3, ia;
    dp4a.s32.s32 ib1, q0_4, ub0, DBASE;
    dp4a.s32.s32 ib1, q0_5, ub1, ib1;
    dp4a.s32.s32 ib1, q0_6, ub2, ib1;
    dp4a.s32.s32 ib1, q0_7, ub3, ib1;
    mov.b32 fi, ib1;
    fma.rn.ftz.f32 fp, fl1_0, fi, nc1_0;     // ls1 * i1, exactly
    mov.b32 fi, ia;
    add.ftz.f32 fi, fi, 0fCB400000;              // i0, exactly
