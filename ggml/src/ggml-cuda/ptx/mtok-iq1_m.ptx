    dp4a.s32.s32 ib1, q1_7, ub3, ib1;
    mov.b32 fi, ib1;
    fma.rn.ftz.f32 fp, fl1_1, fi, nc1_1;     // ls1 * i1, exactly
    mov.b32 fi, ia;
    add.ftz.f32 fi, fi, 0fCB400000;              // i0, exactly
    fma.rn.ftz.f32 fr, fl0_1, fi, fp;         // (float) (ls0 * i0 + ls1 * i1), exactly
    fma.rn.ftz.f32 sf1_1, fa, fr, sf1_1;
    ld.shared.v4.u32 {ua0, ua1, ua2, ua3}, [au2+224];
    ld.shared.v4.u32 {ub0, ub1, ub2, ub3}, [au2+240];
    ld.shared.f32 fa, [ad2+28];
    dp4a.s32.s32 ia, q0_0, ua0, DBASE;
    dp4a.s32.s32 ia, q0_1, ua1, ia;
    dp4a.s32.s32 ia, q0_2, ua2, ia;
    dp4a.s32.s32 ia, q0_3, ua3, ia;
    dp4a.s32.s32 ib1, q0_4, ub0, DBASE;
    dp4a.s32.s32 ib1, q0_5, ub1, ib1;
    dp4a.s32.s32 ib1, q0_6, ub2, ib1;
    dp4a.s32.s32 ib1, q0_7, ub3, ib1;
    mov.b32 fi, ib1;
    fma.rn.ftz.f32 fp, fl1_0, fi, nc1_0;     // ls1 * i1, exactly
    mov.b32 fi, ia;
    add.ftz.f32 fi, fi, 0fCB400000;              // i0, exactly
    fma.rn.ftz.f32 fr, fl0_0, fi, fp;         // (float) (ls0 * i0 + ls1 * i1), exactly
    fma.rn.ftz.f32 sf2_0, fa, fr, sf2_0;
    dp4a.s32.s32 ia, q1_0, ua0, DBASE;
    dp4a.s32.s32 ia, q1_1, ua1, ia;
    dp4a.s32.s32 ia, q1_2, ua2, ia;
    dp4a.s32.s32 ia, q1_3, ua3, ia;
    dp4a.s32.s32 ib1, q1_4, ub0, DBASE;
    dp4a.s32.s32 ib1, q1_5, ub1, ib1;
    dp4a.s32.s32 ib1, q1_6, ub2, ib1;
    dp4a.s32.s32 ib1, q1_7, ub3, ib1;
    mov.b32 fi, ib1;
    fma.rn.ftz.f32 fp, fl1_1, fi, nc1_1;     // ls1 * i1, exactly
    mov.b32 fi, ia;
    add.ftz.f32 fi, fi, 0fCB400000;              // i0, exactly
    fma.rn.ftz.f32 fr, fl0_1, fi, fp;         // (float) (ls0 * i0 + ls1 * i1), exactly
    fma.rn.ftz.f32 sf2_1, fa, fr, sf2_1;
    prmt.b32 t0, w0_12, w0_13, 0x7531;  // bytes 1, 3 of both words: n0 .. n3 in their high nibbles
    shl.b32 t1, t0, 4;
    lop3.b32 t0, t0, t1, KF0, 0xE4;         // high nibbles from t0, low from t1: bytes 1, 3 = n1 n0, n3 n2
    prmt.b32 dsh, t0, ZERO, 0x0031;         // d in the low half
    mov.b32 {h0, h1}, dsh;
    cvt.f32.f16 fd, h0;
    mul.ftz.f32 fd, fd, 0f3E000000;
    fma.rn.ftz.f32 acc0_0, fd, sf0_0, acc0_0;
    fma.rn.ftz.f32 acc1_0, fd, sf1_0, acc1_0;
    fma.rn.ftz.f32 acc2_0, fd, sf2_0, acc2_0;
    prmt.b32 t0, w1_12, w1_13, 0x7531;  // bytes 1, 3 of both words: n0 .. n3 in their high nibbles
    shl.b32 t1, t0, 4;
    lop3.b32 t0, t0, t1, KF0, 0xE4;         // high nibbles from t0, low from t1: bytes 1, 3 = n1 n0, n3 n2
    prmt.b32 dsh, t0, ZERO, 0x0031;         // d in the low half
    mov.b32 {h0, h1}, dsh;
    cvt.f32.f16 fd, h0;
    mul.ftz.f32 fd, fd, 0f3E000000;
    fma.rn.ftz.f32 acc0_1, fd, sf0_1, acc0_1;
    fma.rn.ftz.f32 acc1_1, fd, sf1_1, acc1_1;
    fma.rn.ftz.f32 acc2_1, fd, sf2_1, acc2_1;
    add.u32 itr, itr, 1;
    setp.lt.u32 p0, itr, 5;
    @p0 bra.uni N3_ITER;
    // the row's two lanes summed, then up * SiLU(gate) (ggml_cuda_op_silu_single under -use_fast_math)
    mov.b32 rt0, acc0_0;
    shfl.sync.bfly.b32 rt1, rt0, 1, 31, -1;
    mov.b32 fs, rt1;
    add.ftz.f32 acc0_0, acc0_0, fs;
    mov.b32 rt0, acc0_1;
    shfl.sync.bfly.b32 rt1, rt0, 1, 31, -1;
    mov.b32 fs, rt1;
    add.ftz.f32 acc0_1, acc0_1, fs;
    mov.b32 rt0, acc1_0;
    shfl.sync.bfly.b32 rt1, rt0, 1, 31, -1;
    mov.b32 fs, rt1;
    add.ftz.f32 acc1_0, acc1_0, fs;
    mov.b32 rt0, acc1_1;
    shfl.sync.bfly.b32 rt1, rt0, 1, 31, -1;
    mov.b32 fs, rt1;
    add.ftz.f32 acc1_1, acc1_1, fs;
    mov.b32 rt0, acc2_0;
    shfl.sync.bfly.b32 rt1, rt0, 1, 31, -1;
    mov.b32 fs, rt1;
    add.ftz.f32 acc2_0, acc2_0, fs;
    mov.b32 rt0, acc2_1;
    shfl.sync.bfly.b32 rt1, rt0, 1, 31, -1;
    mov.b32 fs, rt1;
    add.ftz.f32 acc2_1, acc2_1, fs;
    setp.eq.u32 p0, sl, 0;
    setp.lt.u32 pst, row0, nrows;
    and.pred pst, pst, p0;
    mul.ftz.f32 fe, acc0_1, 0fBFB8AA3B;
    ex2.approx.ftz.f32 fe, fe;
    add.ftz.f32 fe, fe, 0f3F800000;
    div.approx.ftz.f32 fg, acc0_1, fe;
    mul.ftz.f32 fu, acc0_0, fg;
    add.u32 t0, dc0, row0;
    mul.wide.u32 o64, t0, 4;
    add.u64 a64, dstp, o64;
    @pst st.global.f32 [a64], fu;
    mul.ftz.f32 fe, acc1_1, 0fBFB8AA3B;
    ex2.approx.ftz.f32 fe, fe;
    add.ftz.f32 fe, fe, 0f3F800000;
    div.approx.ftz.f32 fg, acc1_1, fe;
    mul.ftz.f32 fu, acc1_0, fg;
    add.u32 t0, dc1, row0;
    mul.wide.u32 o64, t0, 4;
    add.u64 a64, dstp, o64;
    @pst st.global.f32 [a64], fu;
    mul.ftz.f32 fe, acc2_1, 0fBFB8AA3B;
    ex2.approx.ftz.f32 fe, fe;
    add.ftz.f32 fe, fe, 0f3F800000;
    div.approx.ftz.f32 fg, acc2_1, fe;
    mul.ftz.f32 fu, acc2_0, fg;
    add.u32 t0, dc2, row0;
    mul.wide.u32 o64, t0, 4;
    add.u64 a64, dstp, o64;
    @pst st.global.f32 [a64], fu;
    add.u32 rbi, rbi, 1;
    bra.uni N3_ROWBLOCK;

BODY4:
    // groups of 4 member(s): member j's output offset dc<j>
    shfl.sync.idx.b32 dc0, doff, 0, 31, -1;
    shfl.sync.idx.b32 dc1, doff, 1, 31, -1;
    shfl.sync.idx.b32 dc2, doff, 2, 31, -1;
    shfl.sync.idx.b32 dc3, doff, 3, 31, -1;
    mov.u32 rbi, 0;
N4_ROWBLOCK:
    setp.ge.u32 p0, rbi, rb;
    @p0 bra.uni DONE;
    add.u32 rblk, rbx, rbi;
    setp.ge.u32 p0, rblk, nrowblocks;
    @p0 bra.uni DONE;
    // rows 4 apart: warp w takes rows w, w + 4, ..., w + 60 of the row block; lane pair grp row w + 4 grp
    shl.b32 row0, rblk, 6;
    add.u32 row0, row0, warp;
    shl.b32 t0, grp, 2;
    add.u32 row0, row0, t0;
    add.u32 t0, nrows, -1;
    min.u32 rowc, row0, t0;
    mul.wide.u32 ro64, rowc, row_bytes;
    add.u64 rw0, xu, ro64;
    add.u64 rw1, xg, ro64;
    mov.f32 acc0_0, 0f00000000;
    mov.f32 acc0_1, 0f00000000;
    mov.f32 acc1_0, 0f00000000;
    mov.f32 acc1_1, 0f00000000;
    mov.f32 acc2_0, 0f00000000;
    mov.f32 acc2_1, 0f00000000;
    mov.f32 acc3_0, 0f00000000;
    mov.f32 acc3_1, 0f00000000;
    mov.u32 itr, 0;
N4_ITER:
    // the lane's super-block c = 2 it + sl: its activations au (member 0) and scales ad
    shl.b32 cs, itr, 1;
    add.u32 cs, cs, sl;
    mad.lo.u32 au, cs, 272, act;
    shl.b32 t0, cs, 5;
    add.u32 ad, ad0, t0;
    mad.lo.u32 au1, act_tok, 1, au;
    mad.lo.u32 ad1, act_tok, 1, ad;
    mad.lo.u32 au2, act_tok, 2, au;
    mad.lo.u32 ad2, act_tok, 2, ad;
    mad.lo.u32 au3, act_tok, 3, au;
    mad.lo.u32 ad3, act_tok, 3, ad;
    // both matrices' super-blocks: lane sl loads its 7 aligned 8-byte units from segment + 56 sl, w<m>_k = bytes 4k .. 4k + 3
    mul.lo.u32 sego, itr, 112;
    cvt.u64.u32 w64, sego;
    add.u64 seg, rw0, w64;
    add.u64 seg, seg, sl64;
    ld.global.nc.v2.u32 {w0_0, w0_1}, [seg+0];
    ld.global.nc.v2.u32 {w0_2, w0_3}, [seg+8];
    ld.global.nc.v2.u32 {w0_4, w0_5}, [seg+16];
    ld.global.nc.v2.u32 {w0_6, w0_7}, [seg+24];
    ld.global.nc.v2.u32 {w0_8, w0_9}, [seg+32];
    ld.global.nc.v2.u32 {w0_10, w0_11}, [seg+40];
    ld.global.nc.v2.u32 {w0_12, w0_13}, [seg+48];
    add.u64 seg, rw1, w64;
    add.u64 seg, seg, sl64;
    ld.global.nc.v2.u32 {w1_0, w1_1}, [seg+0];
    ld.global.nc.v2.u32 {w1_2, w1_3}, [seg+8];
    ld.global.nc.v2.u32 {w1_4, w1_5}, [seg+16];
    ld.global.nc.v2.u32 {w1_6, w1_7}, [seg+24];
    ld.global.nc.v2.u32 {w1_8, w1_9}, [seg+32];
    ld.global.nc.v2.u32 {w1_10, w1_11}, [seg+40];
    ld.global.nc.v2.u32 {w1_12, w1_13}, [seg+48];
    mov.f32 sf0_0, 0f00000000;
    mov.f32 sf0_1, 0f00000000;
    mov.f32 sf1_0, 0f00000000;
    mov.f32 sf1_1, 0f00000000;
    mov.f32 sf2_0, 0f00000000;
    mov.f32 sf2_1, 0f00000000;
    mov.f32 sf3_0, 0f00000000;
    mov.f32 sf3_1, 0f00000000;
    // blocks 0..3: the scales as bytes 2 s + 1
    shl.b32 ts, w0_12, 1;
    lop3.b32 tz, ts, KS0, K01, 0xEA;        // ((sw << 1) & 0x000E000E) | 0x01010101: 2 ls0 + 1, blocks 4h, 4h + 2
    shl.b32 ts, w0_12, 3;
    lop3.b32 e0_0, ts, KS1, tz, 0xEA;       // | ((sw << 3) & 0x0E000E00): blocks 4h + 1, 4h + 3
    shr.b32 ts, w0_12, 2;
    lop3.b32 tz, ts, KS0, K01, 0xEA;        // ((sw >> 2) & 0x000E000E) | 0x01010101: 2 ls1 + 1, blocks 4h, 4h + 2
    lop3.b32 e1_0, w0_12, KS1, tz, 0xEA;    // | (sw & 0x0E000E00): blocks 4h + 1, 4h + 3
    shl.b32 ts, w1_12, 1;
    lop3.b32 tz, ts, KS0, K01, 0xEA;        // ((sw << 1) & 0x000E000E) | 0x01010101: 2 ls0 + 1, blocks 4h, 4h + 2
    shl.b32 ts, w1_12, 3;
    lop3.b32 e0_1, ts, KS1, tz, 0xEA;       // | ((sw << 3) & 0x0E000E00): blocks 4h + 1, 4h + 3
    shr.b32 ts, w1_12, 2;
    lop3.b32 tz, ts, KS0, K01, 0xEA;        // ((sw >> 2) & 0x000E000E) | 0x01010101: 2 ls1 + 1, blocks 4h, 4h + 2
    lop3.b32 e1_1, w1_12, KS1, tz, 0xEA;    // | (sw & 0x0E000E00): blocks 4h + 1, 4h + 3
    // block 0: weights 0..31
    shr.b32 qh4_0, w0_8, 4;            // the qh nibbles of odd groups as low nibbles
    prmt.b32 px, w0_0, w0_8, 0x0040;  // group 0: the qs byte, the qh nibble above it
    bfi.b32 ea, px, ZERO, 2, 12;      // the 11-bit grid index and the delta's sign: the entry's word
    add.u32 ea, ea, tabb;
    ld.shared.u32 cw, [ea];
    prmt.b32 q0_0, LP, LN, cw;      // weights 0, 4, 1, 5: 8 (grid + delta)
    shr.b32 sh, cw, 16;
    prmt.b32 q0_1, LP, LN, sh;      // weights 2, 6, 3, 7
    prmt.b32 px, w0_0, qh4_0, 0x0041;  // group 1: the qs byte, the qh nibble above it
    bfi.b32 ea, px, ZERO, 2, 12;      // the 11-bit grid index and the delta's sign: the entry's word
    add.u32 ea, ea, tabb;
    ld.shared.u32 cw, [ea];
    prmt.b32 q0_2, LP, LN, cw;      // weights 0, 4, 1, 5: 8 (grid + delta)
    shr.b32 sh, cw, 16;
    prmt.b32 q0_3, LP, LN, sh;      // weights 2, 6, 3, 7
    prmt.b32 px, w0_0, w0_8, 0x0052;  // group 2: the qs byte, the qh nibble above it
    bfi.b32 ea, px, ZERO, 2, 12;      // the 11-bit grid index and the delta's sign: the entry's word
    add.u32 ea, ea, tabb;
    ld.shared.u32 cw, [ea];
    prmt.b32 q0_4, LP, LN, cw;      // weights 0, 4, 1, 5: 8 (grid + delta)
    shr.b32 sh, cw, 16;
    prmt.b32 q0_5, LP, LN, sh;      // weights 2, 6, 3, 7
    prmt.b32 px, w0_0, qh4_0, 0x0053;  // group 3: the qs byte, the qh nibble above it
    bfi.b32 ea, px, ZERO, 2, 12;      // the 11-bit grid index and the delta's sign: the entry's word
    add.u32 ea, ea, tabb;
    ld.shared.u32 cw, [ea];
    prmt.b32 q0_6, LP, LN, cw;      // weights 0, 4, 1, 5: 8 (grid + delta)
    shr.b32 sh, cw, 16;
    prmt.b32 q0_7, LP, LN, sh;      // weights 2, 6, 3, 7
    bfe.u32 ts, e0_0, 0, 8;
    cvt.rn.f32.u32 fl0_0, ts;           // 2 ls0 + 1
    bfe.u32 ts, e1_0, 0, 8;
    cvt.rn.f32.u32 fl1_0, ts;           // 2 ls1 + 1
    mul.ftz.f32 nc1_0, fl1_0, 0fCB400000;  // -(2 ls1 + 1) * 1.5 * 2^23
    shr.b32 qh4_1, w1_8, 4;            // the qh nibbles of odd groups as low nibbles
    prmt.b32 px, w1_0, w1_8, 0x0040;  // group 0: the qs byte, the qh nibble above it
    bfi.b32 ea, px, ZERO, 2, 12;      // the 11-bit grid index and the delta's sign: the entry's word
    add.u32 ea, ea, tabb;
    ld.shared.u32 cw, [ea];
    prmt.b32 q1_0, LP, LN, cw;      // weights 0, 4, 1, 5: 8 (grid + delta)
    shr.b32 sh, cw, 16;
    prmt.b32 q1_1, LP, LN, sh;      // weights 2, 6, 3, 7
    prmt.b32 px, w1_0, qh4_1, 0x0041;  // group 1: the qs byte, the qh nibble above it
    bfi.b32 ea, px, ZERO, 2, 12;      // the 11-bit grid index and the delta's sign: the entry's word
    add.u32 ea, ea, tabb;
    ld.shared.u32 cw, [ea];
    prmt.b32 q1_2, LP, LN, cw;      // weights 0, 4, 1, 5: 8 (grid + delta)
    shr.b32 sh, cw, 16;
    prmt.b32 q1_3, LP, LN, sh;      // weights 2, 6, 3, 7
    prmt.b32 px, w1_0, w1_8, 0x0052;  // group 2: the qs byte, the qh nibble above it
    bfi.b32 ea, px, ZERO, 2, 12;      // the 11-bit grid index and the delta's sign: the entry's word
    add.u32 ea, ea, tabb;
    ld.shared.u32 cw, [ea];
    prmt.b32 q1_4, LP, LN, cw;      // weights 0, 4, 1, 5: 8 (grid + delta)
    shr.b32 sh, cw, 16;
    prmt.b32 q1_5, LP, LN, sh;      // weights 2, 6, 3, 7
    prmt.b32 px, w1_0, qh4_1, 0x0053;  // group 3: the qs byte, the qh nibble above it
    bfi.b32 ea, px, ZERO, 2, 12;      // the 11-bit grid index and the delta's sign: the entry's word
    add.u32 ea, ea, tabb;
    ld.shared.u32 cw, [ea];
    prmt.b32 q1_6, LP, LN, cw;      // weights 0, 4, 1, 5: 8 (grid + delta)
    shr.b32 sh, cw, 16;
    prmt.b32 q1_7, LP, LN, sh;      // weights 2, 6, 3, 7
    bfe.u32 ts, e0_1, 0, 8;
    cvt.rn.f32.u32 fl0_1, ts;           // 2 ls0 + 1
    bfe.u32 ts, e1_1, 0, 8;
    cvt.rn.f32.u32 fl1_1, ts;           // 2 ls1 + 1
    mul.ftz.f32 nc1_1, fl1_1, 0fCB400000;  // -(2 ls1 + 1) * 1.5 * 2^23
    ld.shared.v4.u32 {ua0, ua1, ua2, ua3}, [au+0];
    ld.shared.v4.u32 {ub0, ub1, ub2, ub3}, [au+16];
    ld.shared.f32 fa, [ad+0];
    dp4a.s32.s32 ia, q0_0, ua0, DBASE;
    dp4a.s32.s32 ia, q0_1, ua1, ia;
    dp4a.s32.s32 ia, q0_2, ua2, ia;
    dp4a.s32.s32 ia, q0_3, ua3, ia;
    dp4a.s32.s32 ib1, q0_4, ub0, DBASE;
    dp4a.s32.s32 ib1, q0_5, ub1, ib1;
    dp4a.s32.s32 ib1, q0_6, ub2, ib1;
    dp4a.s32.s32 ib1, q0_7, ub3, ib1;
    mov.b32 fi, ib1;
    fma.rn.ftz.f32 fp, fl1_0, fi, nc1_0;     // ls1 * i1, exactly
    mov.b32 fi, ia;
    add.ftz.f32 fi, fi, 0fCB400000;              // i0, exactly
    fma.rn.ftz.f32 fr, fl0_0, fi, fp;         // (float) (ls0 * i0 + ls1 * i1), exactly
    fma.rn.ftz.f32 sf0_0, fa, fr, sf0_0;
    dp4a.s32.s32 ia, q1_0, ua0, DBASE;
    dp4a.s32.s32 ia, q1_1, ua1, ia;
    dp4a.s32.s32 ia, q1_2, ua2, ia;
    dp4a.s32.s32 ia, q1_3, ua3, ia;
    dp4a.s32.s32 ib1, q1_4, ub0, DBASE;
    dp4a.s32.s32 ib1, q1_5, ub1, ib1;
    dp4a.s32.s32 ib1, q1_6, ub2, ib1;
    dp4a.s32.s32 ib1, q1_7, ub3, ib1;
    mov.b32 fi, ib1;
    fma.rn.ftz.f32 fp, fl1_1, fi, nc1_1;     // ls1 * i1, exactly
    mov.b32 fi, ia;
    add.ftz.f32 fi, fi, 0fCB400000;              // i0, exactly
    fma.rn.ftz.f32 fr, fl0_1, fi, fp;         // (float) (ls0 * i0 + ls1 * i1), exactly
    fma.rn.ftz.f32 sf0_1, fa, fr, sf0_1;
    ld.shared.v4.u32 {ua0, ua1, ua2, ua3}, [au1+0];
    ld.shared.v4.u32 {ub0, ub1, ub2, ub3}, [au1+16];
    ld.shared.f32 fa, [ad1+0];
    dp4a.s32.s32 ia, q0_0, ua0, DBASE;
    dp4a.s32.s32 ia, q0_1, ua1, ia;
    dp4a.s32.s32 ia, q0_2, ua2, ia;
    dp4a.s32.s32 ia, q0_3, ua3, ia;
    dp4a.s32.s32 ib1, q0_4, ub0, DBASE;
    dp4a.s32.s32 ib1, q0_5, ub1, ib1;
    dp4a.s32.s32 ib1, q0_6, ub2, ib1;
    dp4a.s32.s32 ib1, q0_7, ub3, ib1;
    mov.b32 fi, ib1;
    fma.rn.ftz.f32 fp, fl1_0, fi, nc1_0;     // ls1 * i1, exactly
    mov.b32 fi, ia;
    add.ftz.f32 fi, fi, 0fCB400000;              // i0, exactly
    fma.rn.ftz.f32 fr, fl0_0, fi, fp;         // (float) (ls0 * i0 + ls1 * i1), exactly
    fma.rn.ftz.f32 sf1_0, fa, fr, sf1_0;
    dp4a.s32.s32 ia, q1_0, ua0, DBASE;
    dp4a.s32.s32 ia, q1_1, ua1, ia;
    dp4a.s32.s32 ia, q1_2, ua2, ia;
    dp4a.s32.s32 ia, q1_3, ua3, ia;
    dp4a.s32.s32 ib1, q1_4, ub0, DBASE;
    dp4a.s32.s32 ib1, q1_5, ub1, ib1;
    dp4a.s32.s32 ib1, q1_6, ub2, ib1;
