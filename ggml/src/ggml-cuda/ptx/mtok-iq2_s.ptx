    dp4a.s32.s32 ia, q1_0, ua0, DBASE;
    dp4a.s32.s32 ia, q1_1, ua1, ia;
    dp4a.s32.s32 ia, q1_2, ua2, ia;
    dp4a.s32.s32 ia, q1_3, ua3, ia;
    dp4a.s32.s32 ib1, q1_4, ub0, DBASE;
    dp4a.s32.s32 ib1, q1_5, ub1, ib1;
    dp4a.s32.s32 ib1, q1_6, ub2, ib1;
    dp4a.s32.s32 ib1, q1_7, ub3, ib1;
    mov.b32 fi, ib1;
    fma.rn.ftz.f32 fp, fl1_1, fi, nc1_1;     // ls1 * i1, exactly
    mov.b32 fi, ia;
    add.ftz.f32 fi, fi, 0fCB400000;              // i0, exactly
    fma.rn.ftz.f32 fr, fl0_1, fi, fp;         // (float) (ls0 * i0 + ls1 * i1), exactly
    fma.rn.ftz.f32 sf7_1, fa, fr, sf7_1;
    // the super-block's d: lane 0's in the low half of dw, lane 1's in the high half
    shr.b32 t0, dw0, 16;
    selp.b32 dsh, t0, dw0, psl;
    mov.b32 {h0, h1}, dsh;
    cvt.f32.f16 fd, h0;
    mul.ftz.f32 fd, fd, 0f3E000000;
    fma.rn.ftz.f32 acc0_0, fd, sf0_0, acc0_0;
    fma.rn.ftz.f32 acc1_0, fd, sf1_0, acc1_0;
    fma.rn.ftz.f32 acc2_0, fd, sf2_0, acc2_0;
    fma.rn.ftz.f32 acc3_0, fd, sf3_0, acc3_0;
    fma.rn.ftz.f32 acc4_0, fd, sf4_0, acc4_0;
    fma.rn.ftz.f32 acc5_0, fd, sf5_0, acc5_0;
    fma.rn.ftz.f32 acc6_0, fd, sf6_0, acc6_0;
    fma.rn.ftz.f32 acc7_0, fd, sf7_0, acc7_0;
    shr.b32 t0, dw1, 16;
    selp.b32 dsh, t0, dw1, psl;
    mov.b32 {h0, h1}, dsh;
    cvt.f32.f16 fd, h0;
    mul.ftz.f32 fd, fd, 0f3E000000;
    fma.rn.ftz.f32 acc0_1, fd, sf0_1, acc0_1;
    fma.rn.ftz.f32 acc1_1, fd, sf1_1, acc1_1;
    fma.rn.ftz.f32 acc2_1, fd, sf2_1, acc2_1;
    fma.rn.ftz.f32 acc3_1, fd, sf3_1, acc3_1;
    fma.rn.ftz.f32 acc4_1, fd, sf4_1, acc4_1;
    fma.rn.ftz.f32 acc5_1, fd, sf5_1, acc5_1;
    fma.rn.ftz.f32 acc6_1, fd, sf6_1, acc6_1;
    fma.rn.ftz.f32 acc7_1, fd, sf7_1, acc7_1;
    add.u32 itr, itr, 1;
    setp.lt.u32 p0, itr, 5;
    @p0 bra.uni N8_ITER;
    // the row's two lanes summed, then up * SiLU(gate) (ggml_cuda_op_silu_single under -use_fast_math)
    mov.b32 rt0, acc0_0;
    shfl.sync.bfly.b32 rt1, rt0, 1, 31, -1;
    mov.b32 fs, rt1;
    add.ftz.f32 acc0_0, acc0_0, fs;
    mov.b32 rt0, acc0_1;
    shfl.sync.bfly.b32 rt1, rt0, 1, 31, -1;
    mov.b32 fs, rt1;
    add.ftz.f32 acc0_1, acc0_1, fs;
    mov.b32 rt0, acc1_0;
    shfl.sync.bfly.b32 rt1, rt0, 1, 31, -1;
    mov.b32 fs, rt1;
    add.ftz.f32 acc1_0, acc1_0, fs;
    mov.b32 rt0, acc1_1;
    shfl.sync.bfly.b32 rt1, rt0, 1, 31, -1;
    mov.b32 fs, rt1;
    add.ftz.f32 acc1_1, acc1_1, fs;
    mov.b32 rt0, acc2_0;
    shfl.sync.bfly.b32 rt1, rt0, 1, 31, -1;
    mov.b32 fs, rt1;
    add.ftz.f32 acc2_0, acc2_0, fs;
    mov.b32 rt0, acc2_1;
    shfl.sync.bfly.b32 rt1, rt0, 1, 31, -1;
    mov.b32 fs, rt1;
    add.ftz.f32 acc2_1, acc2_1, fs;
    mov.b32 rt0, acc3_0;
    shfl.sync.bfly.b32 rt1, rt0, 1, 31, -1;
    mov.b32 fs, rt1;
    add.ftz.f32 acc3_0, acc3_0, fs;
    mov.b32 rt0, acc3_1;
    shfl.sync.bfly.b32 rt1, rt0, 1, 31, -1;
    mov.b32 fs, rt1;
    add.ftz.f32 acc3_1, acc3_1, fs;
    mov.b32 rt0, acc4_0;
    shfl.sync.bfly.b32 rt1, rt0, 1, 31, -1;
    mov.b32 fs, rt1;
    add.ftz.f32 acc4_0, acc4_0, fs;
    mov.b32 rt0, acc4_1;
    shfl.sync.bfly.b32 rt1, rt0, 1, 31, -1;
    mov.b32 fs, rt1;
    add.ftz.f32 acc4_1, acc4_1, fs;
    mov.b32 rt0, acc5_0;
    shfl.sync.bfly.b32 rt1, rt0, 1, 31, -1;
    mov.b32 fs, rt1;
    add.ftz.f32 acc5_0, acc5_0, fs;
    mov.b32 rt0, acc5_1;
    shfl.sync.bfly.b32 rt1, rt0, 1, 31, -1;
    mov.b32 fs, rt1;
    add.ftz.f32 acc5_1, acc5_1, fs;
    mov.b32 rt0, acc6_0;
    shfl.sync.bfly.b32 rt1, rt0, 1, 31, -1;
    mov.b32 fs, rt1;
    add.ftz.f32 acc6_0, acc6_0, fs;
    mov.b32 rt0, acc6_1;
    shfl.sync.bfly.b32 rt1, rt0, 1, 31, -1;
    mov.b32 fs, rt1;
    add.ftz.f32 acc6_1, acc6_1, fs;
    mov.b32 rt0, acc7_0;
    shfl.sync.bfly.b32 rt1, rt0, 1, 31, -1;
    mov.b32 fs, rt1;
    add.ftz.f32 acc7_0, acc7_0, fs;
    mov.b32 rt0, acc7_1;
    shfl.sync.bfly.b32 rt1, rt0, 1, 31, -1;
    mov.b32 fs, rt1;
    add.ftz.f32 acc7_1, acc7_1, fs;
    setp.eq.u32 p0, sl, 0;
    setp.lt.u32 pst, row0, nrows;
    and.pred pst, pst, p0;
    mul.ftz.f32 fe, acc0_1, 0fBFB8AA3B;
    ex2.approx.ftz.f32 fe, fe;
    add.ftz.f32 fe, fe, 0f3F800000;
    div.approx.ftz.f32 fg, acc0_1, fe;
    mul.ftz.f32 fu, acc0_0, fg;
    add.u32 t0, dc0, row0;
    mul.wide.u32 o64, t0, 4;
    add.u64 a64, dstp, o64;
    @pst st.global.f32 [a64], fu;
    mul.ftz.f32 fe, acc1_1, 0fBFB8AA3B;
    ex2.approx.ftz.f32 fe, fe;
    add.ftz.f32 fe, fe, 0f3F800000;
    div.approx.ftz.f32 fg, acc1_1, fe;
    mul.ftz.f32 fu, acc1_0, fg;
    add.u32 t0, dc1, row0;
    mul.wide.u32 o64, t0, 4;
    add.u64 a64, dstp, o64;
    @pst st.global.f32 [a64], fu;
    mul.ftz.f32 fe, acc2_1, 0fBFB8AA3B;
    ex2.approx.ftz.f32 fe, fe;
    add.ftz.f32 fe, fe, 0f3F800000;
    div.approx.ftz.f32 fg, acc2_1, fe;
    mul.ftz.f32 fu, acc2_0, fg;
    add.u32 t0, dc2, row0;
    mul.wide.u32 o64, t0, 4;
    add.u64 a64, dstp, o64;
    @pst st.global.f32 [a64], fu;
    mul.ftz.f32 fe, acc3_1, 0fBFB8AA3B;
    ex2.approx.ftz.f32 fe, fe;
    add.ftz.f32 fe, fe, 0f3F800000;
    div.approx.ftz.f32 fg, acc3_1, fe;
    mul.ftz.f32 fu, acc3_0, fg;
    add.u32 t0, dc3, row0;
    mul.wide.u32 o64, t0, 4;
    add.u64 a64, dstp, o64;
    @pst st.global.f32 [a64], fu;
    mul.ftz.f32 fe, acc4_1, 0fBFB8AA3B;
    ex2.approx.ftz.f32 fe, fe;
    add.ftz.f32 fe, fe, 0f3F800000;
    div.approx.ftz.f32 fg, acc4_1, fe;
    mul.ftz.f32 fu, acc4_0, fg;
    add.u32 t0, dc4, row0;
    mul.wide.u32 o64, t0, 4;
    add.u64 a64, dstp, o64;
    @pst st.global.f32 [a64], fu;
    mul.ftz.f32 fe, acc5_1, 0fBFB8AA3B;
    ex2.approx.ftz.f32 fe, fe;
    add.ftz.f32 fe, fe, 0f3F800000;
    div.approx.ftz.f32 fg, acc5_1, fe;
    mul.ftz.f32 fu, acc5_0, fg;
    add.u32 t0, dc5, row0;
    mul.wide.u32 o64, t0, 4;
    add.u64 a64, dstp, o64;
    @pst st.global.f32 [a64], fu;
    mul.ftz.f32 fe, acc6_1, 0fBFB8AA3B;
    ex2.approx.ftz.f32 fe, fe;
    add.ftz.f32 fe, fe, 0f3F800000;
    div.approx.ftz.f32 fg, acc6_1, fe;
    mul.ftz.f32 fu, acc6_0, fg;
    add.u32 t0, dc6, row0;
    mul.wide.u32 o64, t0, 4;
    add.u64 a64, dstp, o64;
    @pst st.global.f32 [a64], fu;
    mul.ftz.f32 fe, acc7_1, 0fBFB8AA3B;
    ex2.approx.ftz.f32 fe, fe;
    add.ftz.f32 fe, fe, 0f3F800000;
    div.approx.ftz.f32 fg, acc7_1, fe;
    mul.ftz.f32 fu, acc7_0, fg;
    add.u32 t0, dc7, row0;
    mul.wide.u32 o64, t0, 4;
    add.u64 a64, dstp, o64;
    @pst st.global.f32 [a64], fu;
    add.u32 rbi, rbi, 1;
    bra.uni N8_ROWBLOCK;

SKIPPED:
    // a skipped slot (id -1): zeros in its rows of the output
    cvt.u64.u32 w64, bz;
    mul.lo.u64 x64, w64, ssd;
    cvt.u64.u32 w64, ky;
    mad.lo.u64 x64, w64, scd, x64;
    cvt.u64.u32 w64, ty;
    mad.lo.u64 x64, w64, scold, x64;
    shl.b64 x64, x64, 2;
    add.u64 dsk, dstp, x64;
    and.b32 sl, lane, 1;
    shr.b32 grp, lane, 1;
    mov.u32 rbi, 0;
SKIP_ROWS:
    setp.ge.u32 p0, rbi, rb;
    @p0 bra.uni DONE;
    mad.lo.u32 rblk, bx, rb, rbi;
    setp.ge.u32 p0, rblk, nrowblocks;
    @p0 bra.uni DONE;
    shl.b32 row0, rblk, 6;
    add.u32 row0, row0, warp;
    shl.b32 t0, grp, 2;
    add.u32 row0, row0, t0;
    setp.eq.u32 p1, sl, 0;
    setp.lt.u32 p2, row0, nrows;
    and.pred p1, p1, p2;
    mul.wide.u32 o64, row0, 4;
    add.u64 a64, dsk, o64;
    @p1 st.global.f32 [a64], 0f00000000;
    add.u32 rbi, rbi, 1;
    bra.uni SKIP_ROWS;
DONE:
    ret;
}

