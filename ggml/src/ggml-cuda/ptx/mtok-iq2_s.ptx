    prmt.b32 w1_1, u1_1, u1_2, sel;
    prmt.b32 w1_2, u1_2, u1_3, sel;
    prmt.b32 w1_3, u1_3, u1_4, sel;
    prmt.b32 w1_4, u1_4, u1_5, sel;
    prmt.b32 w1_5, u1_5, u1_6, sel;
    prmt.b32 w1_6, u1_6, u1_7, sel;
    prmt.b32 w1_7, u1_7, u1_8, sel;
    prmt.b32 w1_8, u1_8, u1_9, sel;
    prmt.b32 w1_9, u1_9, u1_10, sel;
    prmt.b32 w1_10, u1_10, u1_11, sel;
    prmt.b32 w1_11, u1_11, u1_12, sel;
    prmt.b32 w1_12, u1_12, u1_13, sel;
    prmt.b32 w1_13, u1_13, u1_14, sel;
