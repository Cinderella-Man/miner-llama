# C770: the LLAMA_ and GGML_ names the sources read, for the switch line at load (common_switches_info): every quoted
# "LLAMA_..." or "GGML_..." literal in the C, C++ and CUDA files under ROOT's src, common, tools and ggml/src, sorted,
# written to OUT as a C++ file. A switch added anywhere there joins the list at the next build, with no edit here.
# Usage: cmake -DROOT=<source tree> -DOUT=<file.cpp> -P switch-names.cmake

set(names)
foreach(dir src common tools ggml/src)
    file(GLOB_RECURSE files
        "${ROOT}/${dir}/*.c" "${ROOT}/${dir}/*.cpp" "${ROOT}/${dir}/*.cu" "${ROOT}/${dir}/*.cuh"
        "${ROOT}/${dir}/*.h" "${ROOT}/${dir}/*.hpp")
    foreach(f ${files})
        file(STRINGS "${f}" lines REGEX "\"(LLAMA|GGML)_[A-Z0-9_]+\"")
        foreach(line ${lines})
            string(REGEX MATCHALL "\"(LLAMA|GGML)_[A-Z0-9_]+\"" found "${line}")
            list(APPEND names ${found})
        endforeach()
    endforeach()
endforeach()
list(TRANSFORM names REPLACE "\"" "")
# prefixes such as "LLAMA_ARG_" are not names
list(FILTER names EXCLUDE REGEX "_$")
list(REMOVE_DUPLICATES names)
list(SORT names)
list(LENGTH names n)

set(body "")
foreach(name ${names})
    string(APPEND body "    \"${name}\",\n")
endforeach()
file(WRITE "${OUT}" "// generated by common/switch-names.cmake: do not edit\n#include <cstddef>\n\n"
    "extern const char * const common_switch_names[] = {\n${body}};\n"
    "extern const size_t common_switch_names_n = ${n};\n")
